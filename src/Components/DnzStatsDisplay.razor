<DnzCard class="p-3 d-flex justify-content-around align-items-center flex-wrap gap-3" Variant=@Variant>

    @foreach (var stat in Statistics ?? new())
    {
        <DnzStatsDisplay_Item Value="@stat.Value" Label="@stat.Label" Unit="@stat.Unit" @key=@stat />
    }

</DnzCard>

@code {

    // Nullable a proposito: null = "que lo decida la profundidad". Sin valor el
    // default del enum era Filled, que es justo lo que DnzCard resuelve en el
    // nivel 0, asi que suelta se ve igual y solo cambia al anidarse.
    [Parameter]
    public Variant? Variant { get; set; }

    [Parameter, EditorRequired]
    public List<StatisticModel> Statistics { get; set; } = new();

 
    public class StatisticModel
    {
        public string Value { get; set; }
        public string Label { get; set; }
        public string Unit { get; set; }
    }
}