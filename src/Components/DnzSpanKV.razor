@using Radzen
@using Radzen.Blazor

@if (Visible == false) return;


@if (Horizontal)
{

	<div class="@ContainerClass" role="group" aria-label="@Key" @attributes="AdditionalAttributes">
		<RadzenIcon Icon=@Icon IconColor=@IconColor Style="font-size: 14px;" />
		@*  LA ETIQUETA SE COME EL HUECO, y no es cosmetica: la fila es un flex con
			justify-content-between y TRES hijos, asi que sin esto el navegador reparte
			el sobrante a los dos lados de la etiqueta y la deja flotando en mitad de
			la fila —cada fila en un sitio distinto segun lo que mida su valor. Medido
			en cuatro filas seguidas: las etiquetas empezaban en x=395, 426, 276 y 246.
			Con flex-fill arrancan las cuatro en el mismo x y los valores siguen
			acabando pegados a la derecha: las dos columnas alineadas.  *@
		<small class="text-muted flex-fill">@Key:</small>
		<span class="fw-medium" style="@ValueStyle">@if (ChildContent.IsNotNull()) { @ChildContent } else { @Value }</span>
	</div>

}
else
{


	<div class="@ContainerClass" role="group" aria-label="@Key" @attributes="AdditionalAttributes">


		@if (Icon.IsNotEmpty() && (Icon.StartsWith("/") || Icon.StartsWith("http")))
		{
			<img src=@Icon alt="" class="dnz-spankv__img" />
		}
		else if (Icon.IsNotEmpty())
		{
			<RadzenIcon class="ms-2 align-self-center" Icon="@Icon" IconColor=@IconColor />
		}

		<div class="w-100">
				<span class="@LabelClass" style="@LabelStyle">@Key</span>
				<div class="@ValueClass" style="@ValueStyle">
					@if (ChildContent.IsNotNull()) { @ChildContent } else { @Value }
				</div>
		</div>

	</div>
}

@code {

	[Parameter] public bool Visible { get; set; } = true;
	[Parameter] public string Key { get; set; } = string.Empty;
	[Parameter] public RenderFragment ChildContent { get; set; }
	[Parameter] public string Value { get; set; }
	[Parameter] public bool Horizontal { get; set; } = false;
	[Parameter] public string LabelWidth { get; set; } = string.Empty;
	[Parameter] public string Icon { get; set; } = string.Empty;
	[Parameter] public string IconColor { get; set; } = string.Empty;
	[Parameter] public string ValueColor { get; set; } = string.Empty;
	[Parameter] public bool TextRight { get; set; }
	[Parameter] public string Class { get; set; } = string.Empty;
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }


	private string ContainerClass => $"d-flex  flex-row  {Class} justify-content-between {(Horizontal ? "align-items-center align-content-center" : "align-items-center")} gap-2";
	private string LabelClass => $"rz-text-caption text-muted m-0 p-0 {(Horizontal ? "me-2" : string.Empty)}";
	//	Solo lo usa la maqueta vertical. La horizontal ya manda el valor a la derecha con
	//	el justify-content-between del contenedor, y su rama de aqui llevaba sin usarse
	//	desde siempre: la clase se calculaba y no se pintaba en ningun sitio.
	private string ValueClass => TextRight ? "text-end" : string.Empty;
	private string LabelStyle => string.IsNullOrWhiteSpace(LabelWidth) ? null : $"max-width:{LabelWidth};";
	private string ValueStyle => string.IsNullOrWhiteSpace(ValueColor) ? null : $"color:{ValueColor};";

}
