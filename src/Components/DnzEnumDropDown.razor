@typeparam TEnum

<RadzenDropDown Name="@Name"
                Data="@Items"
                Value="@Value"
                ValueChanged="@ValueChanged"
                TextProperty="Text"
                ValueProperty="Value"
                TValue="TEnum"
                Style="@Style"
                Placeholder="@Placeholder"
                Disabled="@Disabled"
                ItemRender="@MarcarOpcion"
                @attributes="AdditionalAttributes" />

@code {
	[Parameter] public string Name { get; set; } = "";
	[Parameter] public string Style { get; set; } = "width:200px";
	[Parameter] public string Placeholder { get; set; } = "";
	[Parameter] public bool Disabled { get; set; } = false;
	[Parameter] public TEnum Value { get; set; }
	[Parameter] public EventCallback<TEnum> ValueChanged { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

	private List<EnumItem> Items => Enum.GetValues(typeof(TEnum))
		.Cast<TEnum>()
		.Select(e => new EnumItem(GetDisplayName(e!), e))
		.ToList();

	// ── Anclas de test ──────────────────────────────────────────────────────────────────
	// Cada OPCION del desplegable sale marcada con el valor del enum, para poder elegirla
	// sin leer la etiqueta visible (que se traduce). Radzen pone estos atributos tal cual
	// en el <li> de la opcion (ItemRender -> RadzenDropDownItem), asi que NO hace falta
	// <Template> y el aspecto no cambia ni un pixel.
	//   data-testid     "<testid del desplegable>-option", o "dnz-enum-option" si no lleva.
	//   data-testid-id  el nombre del miembro del enum: "Impedir".
	//   data-value      el valor subyacente: "2". Es lo que se guarda.
	//   data-testname   la etiqueta visible, solo para que el fallo del test se lea.
	private void MarcarOpcion(DropDownItemRenderEventArgs<TEnum> args)
	{
		if (args.Item is EnumItem opcion)
		{
			args.Attributes["data-testid"] = OptionTestId;
			args.Attributes["data-testid-id"] = Enum.GetName(typeof(TEnum), opcion.Value).STR();
			args.Attributes["data-value"] = Convert.ToInt64(opcion.Value).STR();
			args.Attributes["data-testname"] = opcion.Text;
		}
	}

	// El testid de la opcion cuelga del testid del propio desplegable a proposito: el panel
	// de opciones de TODOS los desplegables de la pantalla ya esta en el DOM (Radzen lo pinta
	// con display:none y solo lo mueve al body al abrirlo), asi que un testid unico y global
	// chocaria entre dos campos del mismo dialogo.
	private string OptionTestId
	{
		get
		{
			var propio = AdditionalAttributes.IsNull() ? "" : (AdditionalAttributes.GetM("data-testid")?.ToString() ?? "");
			return propio.IsEmpty() ? "dnz-enum-option" : propio + "-option";
		}
	}

	// Conviven dos convenios y hay que mirar los dos: los enums escritos a mano en C# llevan
	// [Display(Name=...)] y los generados del SDK llevan <Description(...)>, que es el convenio
	// oficial de la casa — el propio SDK genera un STR() por enum que lee justo ese atributo.
	// Aqui no se puede llamar (son extensiones VB, una por tipo, y esto es generico), de ahi la
	// reflexion. Display va primero: lo puesto a mano manda.
	// Una Description VACIA no cuenta: 19 miembros "Indefinido" del SDK la llevan a "" y dejarian
	// la opcion en blanco. Sin este guardarrail, el desplegable enseñaba el nombre crudo del
	// miembro ("ImpedirIniciar" en vez de "Impedir Iniciar").
	private static string GetDisplayName(object value)
	{
		var field = value.GetType().GetField(value.ToString()!);
		if (field == null) return value.ToString()!;

		var display = field.GetCustomAttributes(typeof(System.ComponentModel.DataAnnotations.DisplayAttribute), false)
			.Cast<System.ComponentModel.DataAnnotations.DisplayAttribute>()
			.FirstOrDefault();
		if (string.IsNullOrWhiteSpace(display?.Name) == false) return display!.Name!;

		var descripcion = field.GetCustomAttributes(typeof(System.ComponentModel.DescriptionAttribute), false)
			.Cast<System.ComponentModel.DescriptionAttribute>()
			.FirstOrDefault();
		if (string.IsNullOrWhiteSpace(descripcion?.Description) == false) return descripcion!.Description;

		return value.ToString()!;
	}

	private record EnumItem(string Text, TEnum Value);
}
