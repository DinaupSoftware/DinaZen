@namespace DinaZen.Components.DinaupFlex.Forms
@implements IDisposable
@implements ILiveForm
@inject DnzWindowManagerService WindowManagerRef
@inject DnzInterceptorService Interceptor

@if (_isLoading)
{
	<DnzLoader />
}
else if (_virtualForm.IsNotNull())
{
	@* El flag de movil baja en cascada, no de parametro en parametro: asi lo ven el tab,
	   los campos, los contenedores y los botones sin que ningun componente intermedio
	   tenga que reenviarlo. *@
	<CascadingValue Value="_esMovil" Name="DnzFormMovil">
	<div id=@_id
		 data-testid="form-layout"
		 data-testid-id=@(_esMovil ? "movil" : "escritorio")
		 class="dnz-form-view @(_isNewRecord ? "dnz-form-mode-new" : "dnz-form-mode-edit") @(_esMovil ? "dnz-form-movil" : "")" @attributes="AdditionalAttributes">
		@* ── Header ── *@
		<div class="dnz-form-header">
			<div class="dnz-form-header-info">
				<img src=@($"https://dinaupcdn.com/public/{_virtualForm.MainForm.Section.IconoID.STR()}.png") width="20px" height="20px" />
				<span>@_virtualForm.MainForm.Section.Label</span>
				@if (_isNewRecord)
				{
					<RadzenBadge BadgeStyle="BadgeStyle.Success" Variant="Variant.Flat" Text="Nuevo" />
				}
				else if (_virtualForm.MainForm.RowID.IsNotEmpty())
				{
					<RadzenButton Icon="info" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text" Size="ButtonSize.Small" Click="OpenInspector" title="Inspeccionar registro" />
				}
			</div>
			<div class="d-flex align-items-center gap-1">
				@if (_hasChanges)
				{
					<RadzenBadge Visible=@_hasChanges BadgeStyle="BadgeStyle.Info" Text="Modificado" />
				}

				@* ── Print & Annotation buttons (only for existing records) ── *@
				@if (!_isNewRecord && _virtualForm.MainForm.RowID.IsGUID())
				{
					<div class="dnz-form-annotations d-flex align-items-center gap-1">
						@if (_virtualForm.MainForm.Count_PrintDynamicDocumentoList > 0)
						{
							<div class="dnz-annotation-btn-wrap" @onclick="PrintCurrent" title="Imprimir">
								<RadzenIcon Icon="print" Style="font-size:18px" />
								<RadzenBadge BadgeStyle="BadgeStyle.Secondary" IsPill="true" Text="@_virtualForm.MainForm.Count_PrintDynamicDocumentoList.STR()" />
							</div>
						}
						<div class="dnz-annotation-btn-wrap" @onclick="@(() => OpenAnnotations(AnnotationTypeE.Comments))" title="Comentarios">
							<RadzenIcon Icon="chat" Style="font-size:18px" />
							<RadzenBadge BadgeStyle="@(_virtualForm.MainForm.Count_Comments == 0 ? BadgeStyle.Light : BadgeStyle.Info)" IsPill="true" Text="@_virtualForm.MainForm.Count_Comments.STR()" />
						</div>
						<div class="dnz-annotation-btn-wrap" @onclick="@(() => OpenAnnotations(AnnotationTypeE.Files))" title="Archivos">
							<RadzenIcon Icon="attach_file" Style="font-size:18px" />
							<RadzenBadge BadgeStyle="@(_virtualForm.MainForm.Count_AttachedFiles == 0 ? BadgeStyle.Light : BadgeStyle.Info)" IsPill="true" Text="@_virtualForm.MainForm.Count_AttachedFiles.STR()" />
						</div>
						<div class="dnz-annotation-btn-wrap" @onclick="@(() => OpenAnnotations(AnnotationTypeE.PublicGallery))" title="Galeria">
							<RadzenIcon Icon="photo_library" Style="font-size:18px" />
							<RadzenBadge BadgeStyle="@(_virtualForm.MainForm.Count_Gallery == 0 ? BadgeStyle.Light : BadgeStyle.Info)" IsPill="true" Text="@_virtualForm.MainForm.Count_Gallery.STR()" />
						</div>
					</div>
				}

				<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Dark" Variant="Variant.Text" Size="ButtonSize.Small" Click="CloseForm" Style="margin-left:12px; opacity:0.6" />
			</div>
		</div>

		@* ── Mode indicator (thin line) ── *@
		<div class="dnz-form-mode-strip @(_isNewRecord ? "dnz-mode-new" : "dnz-mode-edit")"></div>

		@* ── Mensajes del formulario (los pide un script; el server los retira al responder) ── *@
		@foreach (var msg in _virtualForm.MainForm.DialogList_Msgbox ?? new())
		{
			<RadzenAlert @key=@($"fv-msg-{msg.ID}") AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" Icon="warning" Title="" class="m-2">
				<div class="d-flex flex-column gap-2">
					<span>@msg.Text</span>
					<div class="d-flex flex-wrap gap-2">
						@foreach (var btn in msg.Options)
						{
							<RadzenButton @key=@($"fv-msg-{msg.ID}-{btn.Command}")
										  Text="@btn.Text"
										  ButtonStyle="ButtonStyle.Warning"
										  Size="ButtonSize.Small"
										  Click="@(() => HandleMsgboxCommand(msg.ID, btn.Command))" />
						}
					</div>
				</div>
			</RadzenAlert>
		}

		@* ── Title tab (*) ── *@
		<div class="dnz-form-title">
			@foreach (var tab in _virtualForm.MainForm.Tabs.Where(x => x.TabName == "*"))
			{
				<DnzFormTab @key=@($"fv-{_virtualForm.MainForm.Token}-{tab.TabName}-star")
						  Tab="tab"
						  OnTabChanged="HandleTabChange"
						  OnButtonClick="HandleButtonClick"
						  OnMostrarDialogRequiereGuardar="HandleRequiereGuardar"
						  OnAddItem="HandleAddItem"
						  OnOpenListItem="HandleOpenListItem"
						  OnDeleteItemPrimaryList="HandleDeleteListItem"
						  Client="Client" OnFormatearCodigo="OnFormatearCodigo" />
			}
		</div>

		@* ── Body with tabs (scrollable) ── *@
		<div class="dnz-form-body">
			@{
				var pestanas = _virtualForm.MainForm.Tabs
					.Where(t => t.TabName != "*")
					.OrderByDescending(t => t.TabName == "General")
					.ToList();

				@* Una sola definicion de la pestana para las dos maquetas: lo unico que
				   cambia entre movil y escritorio es el envoltorio, no lo que va dentro. *@
				RenderFragment<VirtualFormDTO.Tab> pintarPestana = tab =>
					@<DnzFormTab @key=@($"fv-{_virtualForm.MainForm.Token}-{tab.TabName}-tabu")
							  Tab="tab"
							  OnTabChanged="HandleTabChange"
							  OnButtonClick="HandleButtonClick"
							  OnMostrarDialogRequiereGuardar="HandleRequiereGuardar"
							  OnAddItem="HandleAddItem"
							  OnOpenListItem="HandleOpenListItem"
							  OnDeleteItemPrimaryList="HandleDeleteListItem"
							  Client="Client" OnFormatearCodigo="OnFormatearCodigo" />;
			}
			@if (_esMovil)
			{
				@* Movil: las solapas dejan de ser solapas y pasan a ser separadores apilados,
				   con una abierta cada vez. Desplegarlas todas seria scroll infinito. *@
				@foreach (var tab in pestanas)
				{
					var abierta = PestanaAbierta(tab, pestanas);

					@if (pestanas.Count > 1)
					{
						<div class="dnz-form-sep @(abierta ? "dnz-form-sep-abierta" : "")"
							 data-testid="form-sep"
							 @key=@($"fv-sep-{tab.TabName}")
							 @onclick=@(() => _tabMovilAbierta = tab.TabName)>
							<RadzenIcon Icon=@(abierta ? "expand_more" : "chevron_right") />
							<span>@tab.TabName</span>
						</div>
					}
					@if (abierta)
					{
						@pintarPestana(tab)
					}
				}
			}
			else
			{
				<RadzenTabs RenderMode="TabRenderMode.Server">
					<Tabs>
						@foreach (var tab in pestanas)
						{
							<RadzenTabsItem @key=@($"fv-{_virtualForm.MainForm.Token}-{tab.TabName}")
											Text="@(_virtualForm.MainForm.Tabs.Count == 2 ? "" : tab.TabName)">
								@pintarPestana(tab)
							</RadzenTabsItem>
						}
					</Tabs>
				</RadzenTabs>
			}

			@if (_successMessage.IsNotEmpty())
			{
				<RadzenAlert AlertStyle="AlertStyle.Success" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => _successMessage = "")" class="rz-mx-4 rz-mb-4">
					@_successMessage
				</RadzenAlert>
			}

			@if (_errorMessage.IsNotEmpty())
			{
				<RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => _errorMessage = "")" class="rz-mx-4 rz-mb-4">
					@_errorMessage
				</RadzenAlert>
			}
		</div>

		@* ── Footer with Extensions + Save / Cancel ── *@
		<div class="dnz-form-footer">
			@* -- Extension buttons (left) -- *@
			<div class="d-flex align-items-center gap-1">
				@foreach (var ext in _extensionButtons)
				{
					var capturedExt = ext;
					<RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Icon="@capturedExt.Icon" Text="@capturedExt.Title" IsBusy="@capturedExt._isBusy" Click="@(() => RunExtension(capturedExt))" />
				}
			</div>
			@* -- Save / Cancel (right) -- *@
			<div class="d-flex align-items-center gap-2">
				@if (_hasChanges || _virtualForm.HasChanged())
				{
					<RadzenButton data-testid="form-save" IsBusy="@_isSaving" ButtonStyle="ButtonStyle.Success" Icon="check" Text="Guardar" Click="@SaveForm" />
					<RadzenButton data-testid="form-cancel" IsBusy="@_isSaving" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Icon="close" Text="Cancelar" Click="@CloseForm" />
				}
				else
				{
					<RadzenButton data-testid="form-save" IsBusy="@_isSaving" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Success" Icon="check" Text="Guardar" Click="@SaveForm" />
					<RadzenButton data-testid="form-close" IsBusy="@_isSaving" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Icon="close" Text="Cerrar" Click="@CloseForm" />
				}
			</div>
		</div>
	</div>
	</CascadingValue>
}
else if (_errorMessage.IsNotEmpty())
{
	<RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => _errorMessage = "")">
		@_errorMessage
	</RadzenAlert>
}


@code {

	// ──────────────────────────────────────────────────────────────
	// Dos maquetas: escritorio (coordenadas) y movil (vertical)
	// ──────────────────────────────────────────────────────────────
	// El formulario que manda el servidor viene maquetado a coordenadas absolutas y pide
	// unos 1000px de ancho. Por debajo de ese umbral se cambia de maqueta: las pestanas
	// pasan a separadores apilados y los campos a una fila cada uno, agrupados por el
	// contenedor que los envuelve (ver DnzFormMobileLayout, que deduce esa agrupacion de
	// la geometria porque en el DTO no existe).
	//
	// La rama se decide por el ANCHO REAL DEL CONTENEDOR, no por el del dispositivo: asi
	// entran igual el telefono, la ventana flotante estrecha y el panel dividido.
	// ──────────────────────────────────────────────────────────────

	// El umbral NO es un numero suelto: es el mismo 1000 del min-width de .dnz-form-view
	// (dinazen-forms.css). Por definicion, el modo movil empieza donde el lienzo de
	// escritorio deja de caber — cualquier otro numero abre una franja en la que el
	// formulario se pinta a coordenadas en un hueco donde no cabe, o al reves.
	// Ojo al tocarlo: el dialog de formulario generico de play mide 1004px, asi que un
	// umbral por encima de eso abre TODOS los formularios en movil estando en escritorio.
	private const int UmbralMovil = 1000;

	private readonly string _id = "dnzform" + System.Guid.NewGuid().ToString("N");
	private bool _esMovil = false;
	private bool _observerIniciado = false;
	private string _tabMovilAbierta = "";
	private DotNetObjectReference<DnzFormView> _dotNetRef;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);

		// No en firstRender: mientras carga solo hay un loader y el div del formulario
		// (el que se mide) todavia no existe.
		if (_observerIniciado || _virtualForm.IsNull()) return;

		_observerIniciado = true;
		_dotNetRef ??= DotNetObjectReference.Create(this);

		// Un solo intento a proposito: si esto falla es porque no hay JS (circuito caido),
		// y reintentar dejaria una llamada fallida por cada render de por vida. El caso de
		// "el div aun no esta" no llega aqui: observeWidth sale sin ruido si no lo encuentra.
		try { await JS.InvokeVoidAsync("DinaZen.observeWidth", _id, _dotNetRef, UmbralMovil); } catch { }
	}

	[JSInvokable]
	public void OnContainerWidthChanged(bool esMovil)
	{
		if (_esMovil == esMovil) return;
		_esMovil = esMovil;
		_ = InvokeAsync(StateHasChanged);
	}

	/// <summary>
	/// Separador desplegado en movil. Siempre hay uno abierto.
	/// </summary>
	private bool PestanaAbierta(VirtualFormDTO.Tab tab, List<VirtualFormDTO.Tab> pestanas)
	{
		if (pestanas.Count == 1) return true;

		// Se recuerda por NOMBRE y no por token: el token se renueva en cada sincronizacion
		// con el servidor, asi que el acordeon se cerraria solo a cada tecla. Si el nombre
		// recordado ya no existe (la pestana desaparecio), se cae a la primera.
		if (_tabMovilAbierta.IsEmpty() || pestanas.Any(p => p.TabName == _tabMovilAbierta) == false)
			return tab.TabName == pestanas[0].TabName;

		return _tabMovilAbierta == tab.TabName;
	}

	/// <summary>
	/// Cliente DinaupSL ya inicializado.
	/// </summary>
	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }

	/// <summary>
	/// GUID de la seccion a cargar. Obligatorio salvo que se informe <see cref="Token"/>.
	/// </summary>
	[Parameter] public string SectionId { get; set; } = "";

	/// <summary>
	/// GUID del registro (opcional). Vacio = formulario nuevo.
	/// </summary>
	[Parameter] public string DatoId { get; set; } = "";

	/// <summary>
	/// Token de una ventana que el server YA tiene abierta.
	/// Con Token el formulario no se abre: se adopta el que ya existe (subventana de alta,
	/// cola de agregado, selector de relacion). Excluyente con SectionId.
	/// </summary>
	[Parameter] public string Token { get; set; } = "";

	/// <summary>
	/// Atributos HTML sueltos (class, style, data-*) que se vuelcan en el elemento raiz.
	/// </summary>
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

	/// <summary>
	/// ID del usuario (opcional).
	/// </summary>
	[Parameter] public string UserId { get; set; } = "";

	/// <summary>
	/// Callback para formatear codigos contables (subcuenta).
	/// </summary>
	[Parameter] public Func<string, Task<string>> OnFormatearCodigo { get; set; }

	/// <summary>
	/// Se dispara cuando el formulario se cierra, con el resultado.
	/// </summary>
	[Parameter] public EventCallback<DinaupFormResult> OnClosed { get; set; }

	/// <summary>
	/// Evento que se dispara cuando se abren las anotaciones.
	/// La app host puede personalizar como se abre el dialogo.
	/// </summary>
	[Parameter] public EventCallback<DinaupAnnotationRequest> OnAnnotationOpen { get; set; }

	/// <summary>
	/// ID de la ventana Window que contiene este form (opcional).
	/// Si tiene valor, el form esta dentro de una ventana flotante.
	/// </summary>
	[Parameter] public string WindowId { get; set; }

	/// <summary>
	/// Field values to pre-fill on a new record (field key → value).
	/// Only applies when DatoId is empty (new record form).
	/// </summary>
	[Parameter] public Dictionary<string, string> PreFillValues { get; set; }

	/// <summary>
	/// List of row dictionaries to pre-fill list fields on a new record.
	/// Only applies when DatoId is empty (new record form).
	/// </summary>
	[Parameter] public List<Dictionary<string, string>> PreFillList { get; set; }

	/// <summary>
	/// File ID to automatically attach when saving (optional).
	/// </summary>
	[Parameter] public Guid AttachFileId { get; set; }

	private bool IsInsideWindow => WindowId.IsNotEmpty();

	private VirtualFormDTO _virtualForm;
	private bool _isLoading = false;
	private bool _isSaving = false;
	private string _errorMessage = "";
	private string _successMessage = "";
	private string _loadedSectionId;
	private string _loadedDatoId;
	private string _loadedToken;
	private bool _hasChanges = false;
	private bool _sessionExpired = false;
	private bool _isNewRecord = false;
	private DateTime _lastCompletedSync = DateTime.UtcNow;
	private bool _isRegistered = false;
	private List<FormExtensionButton> _extensionButtons = new();

	protected override async Task OnParametersSetAsync()
	{
		await base.OnParametersSetAsync();

		if (Client.IsNotNull() && (SectionId.IsNotEmpty() || Token.IsNotEmpty()))
		{
			// Cargar si es la primera vez o si cambiaron los parametros.
			// El Token entra en la comparacion: en modo token SectionId y DatoId van vacios,
			// asi que sin el la condicion nunca se cumpliria y el form no recargaria jamas.
			if (_loadedToken != (Token ?? "") || _loadedSectionId != SectionId || _loadedDatoId != (DatoId ?? ""))
			{
				await LoadForm();
			}
		}
	}

	/// <summary>
	/// Carga o recarga el formulario.
	/// </summary>
	public async Task LoadForm()
	{
		if (Client.IsNull())
		{
			_errorMessage = "Client es obligatorio.";
			return;
		}

		if (SectionId.IsEmpty() && Token.IsEmpty())
		{
			_errorMessage = "SectionId o Token es obligatorio.";
			return;
		}

		_isLoading = true;
		_errorMessage = "";
		_successMessage = "";
		_hasChanges = false;
		_sessionExpired = false;
		StateHasChanged();

		try
		{
			if (Token.IsNotEmpty())
			{
				// Modo token: el server ya tiene la ventana abierta, aqui solo se adopta.
				// Seccion y registro se leen del propio formulario recibido, porque el
				// guardado y el resultado de cierre los necesitan y aqui no vienen dados.
				_virtualForm = await Client.GetOpenedWindows(Token, null);

				if (_virtualForm.IsNull())
				{
					_errorMessage = "La ventana ya no esta abierta en el servidor.";
					return;
				}

				_loadedToken = Token;
				_loadedSectionId = _virtualForm.MainForm.Section.ID.STR();
				_loadedDatoId = _virtualForm.MainForm.RowID ?? "";
			}
			else
			{
				_virtualForm = await Client.FormOpenAsync(
					SectionId,
					DatoId ?? "",
					null,
					PreFillValues,
					PreFillList,
					AttachFileId.IsEmpty() ? "" : AttachFileId.STR()
				);
				_loadedToken = "";
				_loadedSectionId = SectionId;
				_loadedDatoId = DatoId ?? "";
			}

			_isNewRecord = _virtualForm.MainForm.RowID.IsEmpty();

			// Actualizar titulo/icono de la ventana si esta dentro de una.
			// En modo token no: una subventana de alta no debe renombrar a su anfitriona.
			if (IsInsideWindow && Token.IsEmpty())
			{
				var sectionLabel = _virtualForm.MainForm.Section?.Label ?? "";
				var formTitle = _virtualForm.Title ?? "";
				var iconUrl = _virtualForm.MainForm.Section?.IconoID.IsNotEmpty() == true
					? $"https://dinaupcdn.com/public/{_virtualForm.MainForm.Section.IconoID}.png"
					: "";

				WindowManagerRef.UpdateWindowInfo(
					WindowId,
					title: sectionLabel,
					subtitle: formTitle.IsNotEmpty() ? formTitle : (_isNewRecord ? "Nuevo" : null),
					iconUrl: iconUrl
				);
			}

			if (!_isRegistered)
			{
				DnzLiveFormsManager.Register(this);
				_isRegistered = true;
				_lastCompletedSync = DateTime.UtcNow;
			}

			// Cargar extensiones dinamicas del host
			_extensionButtons = await Interceptor.GetFormExtensionsAsync(new FormExtensionsRequest
			{
				SectionId = _loadedSectionId ?? "",
				RowId = _loadedDatoId ?? "",
				IsNew = _isNewRecord,
				Client = Client
			});
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
			_virtualForm = null;
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}
	}

	private async Task HandleTabChange(VirtualFormDTO.Tab newTab)
	{
		try
		{
			_hasChanges = true;
			await SyncForm(
				_virtualForm.WithUpdatedForm(
					_virtualForm.GetFormByTabToken(newTab.TabToken).WithTab(newTab)
				)
			);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	private async Task HandleButtonClick(string buttonId)
	{
		if (_sessionExpired || _virtualForm == null || Client == null) return;

		try
		{
			await SyncForm(await Client.FormSendClick(_virtualForm, buttonId));
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	private void HandleRequiereGuardar(string mensaje)
	{
		NotificationService.Notify(new NotificationMessage
		{
			Severity = NotificationSeverity.Warning,
			Duration = 5000,
			Summary = mensaje
		});
	}

	private async Task SyncForm(VirtualFormDTO vForm)
	{
		try
		{
			var result = await Client.FormUpdate(vForm);
			_virtualForm = result.NewForm;
			await InvokeAsync(StateHasChanged);
			await DnzFormDialogQueue.ProcessAsync(_virtualForm, _servedDialogs, Client, Interceptor, DialogService, WindowManagerRef);
		}
		catch (Exception ex)
		{
			_sessionExpired = true;
			_errorMessage = "Sesion caducada: " + ex.Message;
			await InvokeAsync(StateHasChanged);
		}
	}

	// IDs de cola ya servidos por esta instancia. Ver DnzFormDialogQueue.
	private readonly HashSet<string> _servedDialogs = new();

	/// <summary>
	/// Responde a un mensaje del formulario: el server espera "idMensaje|comando".
	/// </summary>
	private Task HandleMsgboxCommand(string msgId, string command) => HandleButtonClick($"{msgId}|{command}");

	// ── Save ──

	/// <summary>
	/// Guarda el formulario actual.
	/// </summary>
	private async Task SaveForm()
	{
		if (_isSaving || _sessionExpired) return;

		_isSaving = true;
		_errorMessage = "";
		_successMessage = "";
		StateHasChanged();

		try
		{
			bool wasNew = _virtualForm.MainForm.RowID.IsEmpty();
			var saveResult = await Client.FormSave(_virtualForm);
			var newVirtualForm = saveResult.Item1;
			var okResult = saveResult.Item2;

			if (newVirtualForm.IsNotNull() && newVirtualForm.Aviso.IsNotEmpty())
			{
				// Server returned a warning — show it but don't close
				NotificationService.Notify(new NotificationMessage
				{
					Severity = NotificationSeverity.Warning,
					Duration = 15000,
					Summary = newVirtualForm.Aviso
				});
			}
			else if (newVirtualForm == null)
			{
				// Save successful — close the form
				var result = new DinaupFormResult
				{
					Reason = DinaupFormCloseReason.Saved,
					RowId = okResult?.RowID ?? _virtualForm?.MainForm?.RowID ?? "",
					SectionId = _loadedSectionId ?? "",
					WasModified = true,
					Title = _virtualForm?.MainForm?.Tabs?.FirstOrDefault(t => t.TabName == "*")?.Controls?.FirstOrDefault()?.Value ?? ""
				};

				// Interceptor: si devuelve true, no cerrar el form
				if (await Interceptor.TryFormSavedAsync(new FormSavedRequest
				{
					SectionId = result.SectionId,
					RowId = result.RowId,
					Title = result.Title,
					WasNew = wasNew,
					Client = Client
				})) return;

				_virtualForm = null;
				_loadedSectionId = null;
				_loadedDatoId = null;
				_loadedToken = null;
				_hasChanges = false;

				if (IsInsideWindow)
				{
					try { WindowManagerRef.Close(WindowId); } catch { }
				}
				else
				{
					try { DialogService.Close(result); } catch { }
				}
				StateHasChanged();
				await OnClosed.InvokeAsync(result);
				return;
			}
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
			NotificationService.Notify(NotificationSeverity.Error, "Error al guardar", ex.Message);
		}
		finally
		{
			_isSaving = false;
			StateHasChanged();
		}
	}

	// ── Extension buttons ──

	private async Task RunExtension(FormExtensionButton ext)
	{
		if (ext.OnClick == null) return;
		ext._isBusy = true;
		StateHasChanged();
		try
		{
			await ext.OnClick();
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
		finally
		{
			ext._isBusy = false;
			StateHasChanged();
		}
	}

	// ── Print ──

	private async Task PrintCurrent()
	{
		if (_virtualForm?.MainForm?.PrintDynamicDocumentoList.IsEmpty() != false) return;

		try
		{
			var doc = _virtualForm.MainForm.PrintDynamicDocumentoList.First();
			var variables = new Dictionary<string, string>
			{
				{ doc.VariableList.Variables.First().Key, _virtualForm.MainForm.RowID }
			};

			await DnzDynamicDocumentView.OpenAsync(
				DialogService,
				Client,
				doc.IDSTR,
				variables,
				_virtualForm.MainForm.PrintDynamicDocumentoList 
			);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	// ── Annotations ──

	private async Task OpenAnnotations(AnnotationTypeE type)
	{
		if (_virtualForm?.MainForm?.RowID.IsGUID() != true) return;

		var request = new DinaupAnnotationRequest
		{
			SectionId = _virtualForm.MainForm.Section.ID,
			RowId = _virtualForm.MainForm.RowID.ToGUID(),
			Type = type,
			Client = Client
		};

		if (OnAnnotationOpen.HasDelegate)
		{
			await OnAnnotationOpen.InvokeAsync(request);
		}
		else
		{
			// Default: open built-in annotations dialog
			await DnzAnnotationsDialog.OpenAsync(DialogService, Client, request.SectionId, request.RowId, type);
		}
	}

	// ── Inspector ──

	private async Task OpenInspector()
	{
		if (_virtualForm?.MainForm == null) return;

		var allFields = _virtualForm.MainForm.Tabs
			.SelectMany(t => t.Controls ?? Enumerable.Empty<Dinaup.VirtualFormDTO.Control>())
			.ToList();

		var parameters = new Dictionary<string, object>
		{
			{ "RowId", _virtualForm.MainForm.RowID ?? "" },
			{ "SectionId", _virtualForm.MainForm.Section.ID.STR() },
			{ "SectionLabel", _virtualForm.MainForm.Section.Label ?? "" },
			{ "Fields", allFields }
		};

		await DialogService.OpenAsync<DnzFormInspectorDialog>(null, parameters, new DialogOptions
		{
			Width = "min(95%, 700px)",
			Height = "80%",
			CloseDialogOnEsc = true,
			Resizable = true,
			Draggable = true,
			ShowClose = false,
			ShowTitle = false
		});
	}

	// ── Close / Result ──

	/// <summary>
	/// Construye el DinaupFormResult segun el estado actual.
	/// </summary>
	private DinaupFormResult BuildResult(DinaupFormCloseReason? overrideReason = null)
	{
		var reason = overrideReason
			?? (_sessionExpired ? DinaupFormCloseReason.SessionExpired
			   : _hasChanges ? DinaupFormCloseReason.Saved
			   : DinaupFormCloseReason.Cancelled);

		return new DinaupFormResult
		{
			Reason = reason,
			RowId = _virtualForm?.MainForm?.RowID ?? "",
			SectionId = _loadedSectionId ?? "",
			WasModified = _hasChanges,
			Title = _virtualForm?.MainForm?.Tabs?.FirstOrDefault(t => t.TabName == "*")?.Controls?.FirstOrDefault()?.Value ?? ""
		};
	}

	private async Task CloseForm()
	{
		if (_isRegistered)
		{
			DnzLiveFormsManager.Unregister(this);
			_isRegistered = false;
		}

		var result = BuildResult();

		if (_virtualForm != null && Client != null)
		{
			try { await Client.FormCancel(_virtualForm); } catch { }
		}

		_virtualForm = null;
		_loadedSectionId = null;
		_loadedDatoId = null;
		_loadedToken = null;
		_errorMessage = "";
		_hasChanges = false;

		// Cerrar el contenedor (Dialog o Window)
		if (IsInsideWindow)
		{
			try { WindowManagerRef.Close(WindowId); } catch { }
		}
		else
		{
			try { DialogService.Close(result); } catch { }
		}

		StateHasChanged();
		await OnClosed.InvokeAsync(result);
	}

	// ── Public API para integraciones ──

	/// <summary>
	/// Formulario virtual actual (lectura).
	/// </summary>
	public VirtualFormDTO VirtualForm => _virtualForm;

	/// <summary>
	/// Agrega un nuevo item a la lista del formulario.
	/// </summary>
	public async Task List_AddNewItem(Dictionary<string, string> addValues = null)
	{
		if (_sessionExpired || _virtualForm == null || Client == null) return;

		try
		{
			await SyncForm(await Client.FormNewListItem(_virtualForm, addValues));
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	private async Task HandleAddItem()
	{
		await List_AddNewItem();
	}

	private async Task HandleOpenListItem(VirtualFormDTO.FormDetail formList)
	{
		if (_sessionExpired || formList == null) return;

		try
		{
			var syncListTab = new Func<VirtualFormDTO.Tab, Task<VirtualFormDTO.FormDetail>>(SyncListFormTab);

			var parameters = new Dictionary<string, object>
			{
				{ nameof(DnzFormList.FormList), formList },
				{ nameof(DnzFormList.OnTabChangedAsync), syncListTab },
				{ nameof(DnzFormList.Client), Client },
			};
			if (OnFormatearCodigo != null)
				parameters.Add(nameof(DnzFormList.OnFormatearCodigo), OnFormatearCodigo);

			var options = new DialogOptions
			{
				WrapperCssClass = "dinaupdialogform",
				Width = "min(96%, 1100px)",
				Height = "92vh",
				ShowClose = false,
				ShowTitle = false,
				CloseDialogOnEsc = true,
				Resizable = true,
				Draggable = true,
				CloseDialogOnOverlayClick = false
			};

			await DialogService.OpenAsync<DnzFormList>("", parameters, options);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	private async Task<VirtualFormDTO.FormDetail> SyncListFormTab(VirtualFormDTO.Tab newTab)
	{
		if (_sessionExpired || _virtualForm == null || Client == null) return null;
		try
		{
			_hasChanges = true;
			var updatedVForm = _virtualForm.WithUpdatedForm(_virtualForm.GetFormByTabToken(newTab.TabToken).WithTab(newTab));
			var result = await Client.FormUpdate(updatedVForm);
			_virtualForm = result.NewForm;
			await InvokeAsync(StateHasChanged);
			return _virtualForm.GetFormByTabToken(newTab.TabToken);
		}
		catch (Exception ex)
		{
			_sessionExpired = true;
			_errorMessage = "Sesion caducada: " + ex.Message;
			await InvokeAsync(StateHasChanged);
			return null;
		}
	}

	private async Task HandleDeleteListItem(string tokenListId)
	{
		if (_sessionExpired || _virtualForm == null || Client == null) return;

		try
		{
			await SyncForm(await Client.FormRemoveListItem(_virtualForm, tokenListId));
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	// ── LiveForms (Ping) ──

	public void Ping()
	{
		if (_sessionExpired || _virtualForm == null || Client == null) return;
		if (_lastCompletedSync.AddSeconds(25) >= DateTime.UtcNow) return;

		_ = InvokeAsync(async () =>
		{
			try
			{
				await SyncForm(_virtualForm);
				_lastCompletedSync = DateTime.UtcNow;
			}
			catch
			{
				_sessionExpired = true;
				_errorMessage = "Sesion de edicion caducada.";
				StateHasChanged();
			}
		});
	}

	public void Dispose()
	{
		if (_observerIniciado)
		{
			try { _ = JS.InvokeVoidAsync("DinaZen.unobserveWidth", _id); } catch { }
			_observerIniciado = false;
		}
		_dotNetRef?.Dispose();
		_dotNetRef = null;

		if (_isRegistered)
		{
			DnzLiveFormsManager.Unregister(this);
			_isRegistered = false;
		}
		if (_virtualForm != null && Client != null)
		{
			try { _ = Client.FormCancel(_virtualForm); } catch { }
		}
		_virtualForm = null;
	}

	// ── Static helper para abrir como modal ──

	/// <summary>
	/// Abre un DnzFormView como ventana modal (DialogService).
	/// Devuelve DinaupFormResult con el estado al cerrar.
	/// </summary>
	public static async Task<DinaupFormResult> OpenAsync(
		DialogService dialogService,
		DinaupClientC client,
		string sectionId,
		string datoId = "",
		string title = "",
		// El ancho NO puede ser 1000px: ese es justo el UmbralMovil, asi que el formulario
		// nacia rozando la frontera y cualquier borde lo tiraba a la maqueta movil estando
		// en un monitor. Con 1100 hay 100px de holgura, y el min(96%,...) hace que en
		// pantalla estrecha encoja y cruce el umbral a proposito en vez de salirse.
		string width = "min(96%, 1100px)",
		string height = "min(90%, 1000px)")
	{
		var parameters = new Dictionary<string, object>
		{
			{ nameof(Client), client },
			{ nameof(SectionId), sectionId },
			{ nameof(DatoId), datoId ?? "" }
		};

		var options = new DialogOptions
		{
			WrapperCssClass = "dinaupdialogform",
			Width = width,
			Height = height,
			CloseDialogOnEsc = true,
			Resizable = true,
			Draggable = true,
			CloseDialogOnOverlayClick = false,
			ShowClose = false,
			ShowTitle = !string.IsNullOrEmpty(title)
		};

		var dialogResult = await dialogService.OpenAsync<DnzFormView>(title, parameters, options);

		if (dialogResult is DinaupFormResult formResult)
			return formResult;

		// Si se cerro sin resultado (ESC, overlay, etc.)
		return new DinaupFormResult
		{
			Reason = DinaupFormCloseReason.Cancelled,
			SectionId = sectionId,
			RowId = datoId ?? ""
		};
	}

	// ── Static helper para abrir como ventana flotante ──

	/// <summary>
	/// Abre un DnzFormView como ventana flotante (WindowManager).
	/// Retorna el windowId para referencia.
	/// </summary>
	public static string OpenAsWindow(
		DnzWindowManagerService windowManager,
		DinaupClientC client,
		string sectionId,
		string datoId = "",
		string title = "",
		string icon = "")
	{
		var windowId = Guid.NewGuid().ToString("N")[..8];

		RenderFragment content = builder =>
		{
			builder.OpenComponent<DnzFormView>(0);
			builder.AddAttribute(1, nameof(Client), client);
			builder.AddAttribute(2, nameof(SectionId), sectionId);
			builder.AddAttribute(3, nameof(DatoId), datoId ?? "");
			builder.AddAttribute(4, nameof(WindowId), windowId);
			builder.CloseComponent();
		};

		var options = new WindowOptions
		{
			PresetId = windowId,
			Title = title.IsNotEmpty() ? title : "Formulario",
			Icon = icon,
			InitialWidth = 1100,
			InitialHeight = 650,

			// Este formulario SI tiene maqueta estrecha (una fila por campo), asi que se deja
			// encoger hasta ancho de telefono. Con el minimo por defecto (1000) nunca se
			// llegaria a cruzar el umbral y esa maqueta seria inalcanzable.
			MinWidth = 360
		};

		return windowManager.Open(options, content);
	}
}
