@using DinaZen.Components.DinaupFlex.Reports.Provider
@using Radzen


@if (DataControl.InputType == "file") {
	@* ─── Subida de archivo ─── *@
	<div @key=@(DataControl.Token + "-file") class="d-flex w-100 h-100">
		<RadzenCard class="w-100 h-100 d-flex flex-column ">
			@if (subiendoArchivo) {
				<RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Info" @bind-Value=@subiendoArchivoProgreso />
			} else if (fileDTO == null) {
				<div class="d-flex justify-content-between align-items-center">
					<RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@DataControl.Label</RadzenText>
				</div>
				<div style="width: 100%; flex:1; display: flex; justify-content: center; align-items: center;margin:0px;padding:0px">
					<DnzFileUploaderButton Client="@Client" ButtonText="Subir archivo" ButtonIcon="upload_file" MaxFiles="1"
										   OnFilesUploaded="@OnFilesComplete"
										   OnError="@(msg => NotificationService.Notify(NotificationSeverity.Error, msg))" />
				</div>
			} else {
				<div class="d-flex flex-column ">
					<div class="d-flex align-items-center justify-content-between">
						<RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" style="margin:0">@DataControl.Label</RadzenText>
						<div class="d-flex align-items-center gap-1">
							<DnzFileUploaderButton Client="@Client" ButtonText="" ButtonIcon="upload"
												   ButtonStyle="ButtonStyle.Secondary" ButtonSize="ButtonSize.ExtraSmall" MaxFiles="1"
												   OnFilesUploaded="@OnFilesComplete" />
							<RadzenButton Visible=@(fileDTO.IsNotNull()) Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Click=@EliminarRelacion />
						</div>
					</div>
				</div>
				<div style="width: 100%; flex:1; display: flex; justify-content: center; align-items: center;">
					@if (fileDTO.IsNotNull() && fileDTO.IsImage) {
						<img src=@fileDTO.url_original style="max-width: 100%; max-height: @(DataControl.Height - 100)px; object-fit: contain;" />
					} else {
						<DnzFileName IsCompact=true DnzFileNameDisplay=@fileDTO.File DownloadURL=@fileDTO.url_original />
					}
				</div>
				@if (fileDTO.IsNotNull() && fileDTO.IsImage) {
					<a style="font-size:11px" href=@fileDTO.url_original target="_blank"> @fileDTO.File  </a>
				}
			}
		</RadzenCard>
	</div>

} else if (DataControl.TokenList.IsNotEmpty() && Client != null) {
	@* ─── Selector relacional (Report remoto) con RadzenDropDownDataGrid ───
	   Columnas dinámicas del Report, paginado server-side, filtro as-you-type.
	   Sustituye al antiguo flujo Popup + DnzReportView (que tenía el bug del
	   "owner pegado" en grids con N filas paralelas).
	   Layout: respeta IsLabelLeft del DataControl (label izq vs arriba). *@
	<div @key=@(DataControl.Token + "-rel") data-token=@DataControl.Token
		 class="@(DataControl.IsLabelLeft || ModoCelda ? "d-flex align-items-center gap-2 w-100" : "d-flex flex-column w-100")">
		@if (ModoCelda == false) {
			<RadzenLabel ContextMenu=ContextMenuAction class="labelinput" for="@DataControl.Token"
						 style=@(DataControl.IsLabelLeft ? $"width:{DataControl.LabelWidth}px" : "")>
				@DataControl.Label
				<span class="ico_IsModified"></span>
				<span class="ico_IsRequired"></span>
			</RadzenLabel>
		}
		<div class="d-flex align-items-center gap-2 flex-grow-1">
			@if (!ModoCelda && DataControl.Value_Img.IsNotEmpty() && DataControl.Value_Text != "Unidades") {
				<DnzDynamicRowPreviewIMG Style="margin-right:12px;zoom:0.9" Class="opacity-75" @key=@(DataControl.Token + "-img") Data=DataControl />
			}
			<RadzenDropDownDataGrid TValue="DinaupDynamicRowDTO"
									Value="@_selectedRow"
									Data="@_dropRows"
									Count="@_dropTotal"
									LoadData="@OnDropLoadData"
									SelectedItemChanged="@OnDropSelectedItem"
									AllowFiltering="true"
									FilterAsYouType="true"
									AllowSorting="true"
									PageSize="50"
									TextProperty="Title"
									Disabled="@DataControl.IsLocked"
									Placeholder=" "
									Style="flex:1;">
				<Columns>
					@if (_dropColumns != null) {
						@foreach (var col in _dropColumns.Where(c => !c.isColumnHidden)) {
							<RadzenDropDownDataGridColumn @key=@col.Keyword Title="@col.Label"
														  Type="@(Nullable.GetUnderlyingType(col.NetType) ?? col.NetType)"
														  Property="@PropExpr(col)">
								<Template Context="row">
									@(((DinaupDynamicRowDTO)row).GetLegible(col.Keyword))
								</Template>
							</RadzenDropDownDataGridColumn>
						}
					}
				</Columns>
			</RadzenDropDownDataGrid>
			@if (ModoCelda == false) {
				<div class="autoHide d-flex">
					@if (DataControl.IsFilled) {
						@if (DataControl.IsLocked == false) {
							<RadzenButton style="zoom:0.9" @key=@(DataControl.Token + "-clear") Icon="close" Variant="Variant.Text" Click=EliminarRelacion ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" />
						}
						<RadzenButton Click=@(async () => await AccederAsync()) style="zoom:0.9;margin-right:10px" @key=@(DataControl.Token + "-open") Variant="Variant.Text" Icon="open_in_new" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" />
					} else if (DataControl.IsLocked == false) {
						<RadzenButton Click=@(async () => await AgregarAsync()) style="zoom:0.9" @key=@(DataControl.Token + "-add") Variant="Variant.Text" Icon="add" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" />
					}
				</div>
			}
		</div>
	</div>

} else if (DataControl.DropDowList != null && DataControl.DropDowList.Any()) {
	@* ─── Selector inline (DropDowList in-memory) con RadzenDropDown ───
	   Lista predefinida sin Report remoto. Items con Title + Icon + Value. *@
	<div @key=@(DataControl.Token + "-drop") class="d-flex align-items-center gap-2 w-100">
		@if (ModoCelda == false) {
			<RadzenLabel ContextMenu=ContextMenuAction class="labelinput" for="@DataControl.Token"
						 style=@(DataControl.IsLabelLeft ? $"width:{DataControl.LabelWidth}px" : "")>
				@DataControl.Label
				<span class="ico_IsModified"></span>
				<span class="ico_IsRequired"></span>
			</RadzenLabel>
		}
		<RadzenDropDown TValue="string"
						Data="@DataControl.DropDowList"
						Value="@DataControl.Value"
						TextProperty="Title"
						ValueProperty="Value"
						AllowFiltering="true"
						FilterAsYouType="true"
						Disabled="@DataControl.IsLocked"
						Change="@OnInlineDropChange"
						Style="flex:1;" />
	</div>

} else {
	<div class="d-flex flex-column">
		<b>@DataControl.Label</b>
		<span>@DataControl.Value_Text </span>
	</div>
}


@code {

	// ── Parameters ──
	[Parameter] public DinaupClientC Client { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.Control> OnDataControlChanged { get; set; }
	[Parameter] public Dinaup.VirtualFormDTO.Control DataControl { get; set; }
	[Parameter] public EventCallback<MouseEventArgs> ContextMenuAction { get; set; }
	[Parameter] public bool ModoCelda { get; set; }

	// ── Private fields (subida de archivo) ──
	bool subiendoArchivo;
	double subiendoArchivoProgreso;
	DinaupFileDTO fileDTO;

	// ── Selector relacional: cache de columnas+rows del Report ──
	private List<DinaupFieldDTO> _dropColumns;
	private List<DinaupDynamicRowDTO> _dropRows = new();
	private int _dropTotal;
	// Row "stub" para mostrar el valor preseleccionado al editar. Se sustituye
	// cuando el usuario elige otro del dropdown.
	private DinaupDynamicRowDTO _selectedRow;

	private string PropExpr(DinaupFieldDTO col) {
		var t = Nullable.GetUnderlyingType(col.NetType) ?? col.NetType;
		var n = (Nullable.GetUnderlyingType(col.NetType) != null) ? "?" : "";
		var typeName = t.IsEnum ? "Int32" : t.Name;
		return $@"Convert(Convert(it[""{col.Keyword}""], {typeName}{n}), Object)";
	}

	// ── Lifecycle ──

	protected override async Task OnInitializedAsync() {
		await base.OnInitializedAsync();
		// Si el DataControl ya tiene valor (estamos editando un registro
		// existente), construimos un row "stub" para que el dropdown muestre
		// la selección actual en lugar del placeholder. Solo necesita ID y
		// Title para que el TextProperty="Title" lo renderice.
		if (DataControl.Value.IsNotEmpty() && DataControl.Value_Text.IsNotEmpty()) {
			_selectedRow = new DinaupDynamicRowDTO(
				new Dictionary<string, object> {
					{ "id", DataControl.Value },
					{ "nombre", DataControl.Value_Text }
				}, null);
		}
		// Precargar primera página al inicializar para que el dropdown muestre
		// resultados sin que el usuario tenga que buscar+borrar primero.
		if (DataControl.TokenList.IsNotEmpty() && Client != null && DataControl.InputType != "file") {
			await OnDropLoadData(new LoadDataArgs { Skip = 0, Top = 50 });
		}
	}

	protected override Task OnParametersSetAsync() {
		_ = actualizarInfoArchivoAsync();
		return base.OnParametersSetAsync();
	}

	public void Dispose() {
		if (DnzFormConfig.DeepDispose) {
			DataControl = null;
		}
	}

	// ── Carga remota del Report (paginada server-side) ──

	private async Task OnDropLoadData(LoadDataArgs args) {
		if (Client == null || DataControl.TokenList.IsEmpty()) return;
		try {
			var p = new ReportRequestParameters(DataControl.TokenList, args.Top ?? 50) {
				QuerySearch = args.Filter
			};
			p.ApplyLoadingConfiguration(new LoadDataReportC {
				Skip = args.Skip,
				Top = args.Top,
				OrderBy = args.OrderBy,
				Filter = args.Filter
			});
			var response = await Client.Report_GetAsync(p);
			if (response?.DataList != null) {
				_dropColumns = response.DataList.Columns;
				_dropRows = response.DataList.GetDynamicsRowsOBJ()?.ToList() ?? new();
				_dropTotal = response.DataList.TotalResults;
				await InvokeAsync(StateHasChanged);
			}
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, "Error cargando opciones", ex.Message);
		}
	}

	// ── Selección ──

	// Wrapper: SelectedItemChanged espera EventCallback no genérico (object).
	private async Task OnDropSelectedItem(object value) {
		if (value is DinaupDynamicRowDTO row && row.IsNotNull()) {
			_selectedRow = row;
			await SelectOrder(row);
		}
	}

	// Para RadzenDropDown inline (DropDowList) — Change devuelve el Value (string).
	private async Task OnInlineDropChange(object value) {
		var v = value?.ToString() ?? "";
		var item = DataControl.DropDowList.FirstOrDefault(x => x.Value == v);
		if (item.IsNotNull()) {
			await OnDataControlChanged.InvokeAsync(DataControl.WithValue(item.Value).WithValueText(item.Title).WithValueImageURL(item.Icon));
		} else {
			await OnDataControlChanged.InvokeAsync(DataControl.WithValue(v).WithValueText(""));
		}
	}

	async Task SelectOrder(DinaupDynamicRowDTO dataRow) {
		await OnDataControlChanged.InvokeAsync(DataControl.WithValue(dataRow.ID).WithValueText(dataRow.Title).WithValueImageURL(dataRow.PreviewIMG));
	}

	async Task EliminarRelacion() {
		await OnDataControlChanged.InvokeAsync(DataControl.WithValue("").WithValueText(""));
	}

	// ── Acciones del registro relacionado ──

	async Task AccederAsync() {
		if (Client != null)
			await DnzFormView.OpenAsync(DialogService, Client, DataControl.RelationWithSectionId, DataControl.Value);
	}

	async Task AgregarAsync() {
		try {
			if (Client != null) {
				var result = await Client.OpenedFormAddRelation(DataControl.RelationWithSectionId, DataControl.Token);
				var tokenForm = result?.TokenForm;
				if (tokenForm.IsNotEmpty()) {
					var options = new DialogOptions {
						WrapperCssClass = "dinaupdialogform",
						Width = "90%",
						Height = "90%",
						CloseDialogOnEsc = true,
						Resizable = true,
						Draggable = true,
						CloseDialogOnOverlayClick = false,
						ShowClose = false,
						ShowTitle = false
					};
					await DialogService.OpenAsync<DnzFormByTokenView>("", new Dictionary<string, object>
					{
						{ nameof(DnzFormByTokenView.Client), Client },
						{ nameof(DnzFormByTokenView.Token), tokenForm }
					}, options);
				}
			}
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, "Ups.", ex.Message);
		}
	}

	// ── Subida de archivo ──

	void OnProgress(UploadProgressArgs args, string name) {
		if (args.Progress == 100) {
			subiendoArchivo = false;
			subiendoArchivoProgreso = 0;
			InvokeAsync(StateHasChanged);
		} else {
			subiendoArchivo = true;
			subiendoArchivoProgreso = args.Progress;
			InvokeAsync(StateHasChanged);
		}
	}

	async Task OnFilesComplete(List<DinaupFileDTO> files) {
		var x = files?.FirstOrDefault();
		if (x == null) return;
		try {
			await OnDataControlChanged.InvokeAsync(DataControl.WithValue(x.Id.STR()).WithValueText(x.Name));
			_ = actualizarInfoArchivoAsync();
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, ex.Message);
		}
		subiendoArchivo = false;
		_ = InvokeAsync(StateHasChanged);
	}

	void OnError(UploadErrorEventArgs args) {
		subiendoArchivo = false;
		InvokeAsync(StateHasChanged);
	}

	async Task actualizarInfoArchivoAsync() {
		if (fileDTO != null && fileDTO.Id.STR() == DataControl.Value)
			return;
		if (fileDTO != null && DataControl.Value.IsGUID() == false) {
			fileDTO = null;
			_ = InvokeAsync(StateHasChanged);
			return;
		}
		if (DataControl.InputType == "file" && Client != null) {
			if (DataControl.Value.IsGUID()) {
				FileResponse file = await Client.FileGetAsync(DataControl.Value.ToGUID());
				fileDTO = file.Files.Values.First();
				_ = InvokeAsync(StateHasChanged);
			}
		}
	}
}
