@using Radzen.Blazor.Rendering
@inject DnzInterceptorService Interceptor



<div @key=@(DataControl.Token + "-12342334") class="d-flex align-items-center gap-2 justify-content-between @(DataControl.InputType == "file" ? "w-100 h-100" : "") ">


	@if (DataControl.InputType == "file") {


		<DnzCard class="w-100 h-100 d-flex flex-column ">


			@if (subiendoArchivo) {

				<RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Info" @bind-Value=@subiendoArchivoProgreso />

			} else if (fileDTO == null) {


				<div class="d-flex justify-content-between align-items-center">
					<RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">@DataControl.Label</RadzenText>
				</div>


				<div style="width: 100%; flex:1; display: flex; justify-content: center; align-items: center;margin:0px;padding:0px">
					<DnzFileUploaderButton Client="@Client"
										   ButtonText="Subir archivo"
										   ButtonIcon="upload_file"
										   MaxFiles="1"
										   OnFilesUploaded="@OnFilesComplete"
										   OnError="@(msg => NotificationService.Notify(NotificationSeverity.Error, msg))" />
				</div>

			} else {

				<div class="d-flex flex-column ">
					<div class="d-flex align-items-center justify-content-between">
						<RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3" style="margin:0">@DataControl.Label</RadzenText>
						<div class="d-flex align-items-center gap-1">
							<DnzFileUploaderButton Client="@Client"
												   ButtonText=""
												   ButtonIcon="upload"
												   ButtonStyle="ButtonStyle.Secondary"
												   ButtonSize="ButtonSize.ExtraSmall"
												   MaxFiles="1"
												   OnFilesUploaded="@OnFilesComplete" />
							<RadzenButton Visible=@(fileDTO.IsNotNull()) Icon="close" Size="ButtonSize.ExtraSmall" Variant="Variant.Text" ButtonStyle="ButtonStyle.Danger" Click=@EliminarRelacion />
						</div>
					</div>
				</div>



				<div style="width: 100%; flex:1; display: flex; justify-content: center; align-items: center;">
					@if (fileDTO.IsNotNull() && fileDTO.IsImage) {
						<img src=@fileDTO.url_original style="max-width: 100%; max-height: @(DataControl.Height - 100)px; object-fit: contain;" />
					}
					else
					{
						<DnzFileName IsCompact=true DnzFileNameDisplay=@fileDTO.File DownloadURL=@fileDTO.url_original />
					}
				</div>

				@if (fileDTO.IsNotNull() && fileDTO.IsImage) {
					<a style="font-size:11px" href=@fileDTO.url_original target="_blank"> @fileDTO.File  </a>
				}

			}
		</DnzCard>

	} else if (DataControl.TokenList != "" || (DataControl.DropDowList != null && DataControl.DropDowList.Any())) {




		@* En movil la etiqueta nunca va a la izquierda: se lleva un ancho fijo en pixeles
		   que en un telefono deja el campo sin sitio. Se cae a la rama de etiqueta arriba. *@
		@if (DataControl.IsLabelLeft && EsMovil == false) {
			<div @ref=elDivX @onclick=@(args => OpenPopup()) data-token=@DataControl.Token style="cursor:pointer" class="dup_input  justify-content-between  dup_input_estandar d-flex align-items-center  align-content-center gap-2 flex-grow-1">
				@if (ModoCelda == false) {
					<RadzenLabel ContextMenu=ContextMenuAction key=@(DataControl.Token + "-eti") style=@($"width:{DataControl.LabelWidth}px") class="labelinput" for="@DataControl.Token">
						@DataControl.Label
						<span class="ico_IsModified"></span>
						<span class="ico_IsRequired"></span>
					</RadzenLabel>
				}
				<RadzenTextBox class=@(ModoCelda ? "input-autosize" : "flex-grow-1") Value=@DataControl.Value_Text ReadOnly=true></RadzenTextBox>
				<div style="margin-left:-24px; font-size:10px; color: var(--bs-gray); width:20px; height:20px" class="DropDownArrow"> </div>
			</div>

		} else {


			@if (DataControl.Value_Img.IsNotEmpty() && DataControl.Value_Text != "Unidades") {
				<DnzDynamicRowPreviewIMG Style="margin-right:12px;zoom:0.9" Class="opacity-75" @key=@(DataControl.Token + "-1343499") Data=DataControl></DnzDynamicRowPreviewIMG>
			}

			<div Style=" cursor:pointer" @key=@(DataControl.Token + "-2") @ref=elDivX @onclick=@(args => OpenPopup()) data-token=@DataControl.Token class="dup_input  dup_input_estandar d-flex flex-column w-100">
				@if (ModoCelda == false) {
					<RadzenLabel ContextMenu=ContextMenuAction class="labelinput" for="@DataControl.Token">
						@DataControl.Label
						<span class="ico_IsModified"></span>
						<span class="ico_IsRequired"></span>
					</RadzenLabel>
				}

				@if (DataControl.BadgetsStyle.IsNotEmpty()) {
					<div class="d-flex align-items-center rz-textbox p-0 h-auto">
						<div class="flex-grow-1 " style="padding-left:1px; min-width:0; overflow:hidden">
							@if (DataControl.Value_Text.IsNotEmpty()) {
								<DnzBadgetAutoColor Value=@DataControl.Value_Text BadgetStyle=@DataControl.BadgetsStyle Style="display:inline-block; max-width:100%; overflow:hidden; text-overflow:ellipsis; vertical-align:middle" />
							}
						</div>
						<div style=" font-size:10px; color: var(--bs-gray); width:15px; height:20px" class="DropDownArrow"></div>
					</div>
				} else {
					<div class="d-flex align-items-center">
						<RadzenTextBox class=@(ModoCelda ? "input-autosize" : "flex-grow-1") Value=@DataControl.Value_Text ReadOnly=true></RadzenTextBox>
						<div style="margin-left:-19px; font-size:10px; color: var(--bs-gray); width:15px; height:20px" class="DropDownArrow"></div>
					</div>
				}
			</div>
		}


		@if (ModoCelda == false) {
			<div class="autoHide d-flex">

				@if (DataControl.IsFilled) {
					@if (DataControl.IsLocked == false) {
						<RadzenButton style="zoom:0.9" @key=@(DataControl.Token + "-3") Icon="close" Variant="Variant.Text" Click=EliminarRelacion ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" data-testid="selector-relational-remove" />
					}

					@if (DataControl.TokenList != "" && Client != null) {
						<RadzenButton Click=@(async () => await AccederAsync()) style="zoom:0.9;margin-right:10px" @key=@(DataControl.Token + "-4") Variant="Variant.Text" Icon="open_in_new" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" data-testid="selector-relational-open" />
					}
				} else {
					@if (DataControl.TokenList != "" && DataControl.IsLocked == false && Client != null) {
						<RadzenButton Click=@(async () => await AgregarAsync()) style="zoom:0.9" @key=@(DataControl.Token + "-5") Variant="Variant.Text" Icon="add" ButtonStyle="ButtonStyle.Dark" Size="ButtonSize.ExtraSmall" data-testid="selector-relational-add" />
					}
				}
			</div>
		}


	} else {
		<div class="d-flex flex-column">

			<b>@DataControl.Label</b>
			<span>@DataControl.Value_Text </span>
		</div>

	}
</div>




<RadzenPopup @key=@(DataControl.Token + "-6") @ref=popup Lazy=true Open="@OnOpen" Style="display:none;position:absolute; max-width:600px;">

	@* El desplegable flota sobre la pantalla, así que necesita fondo propio y opaco.
	   Estaba en blanco fijo: con el tema oscuro salía un panel blanco encima de todo.
	   El token del menú ya vale blanco en el tema claro, así que ahí no cambia nada. *@
	<div class="desplegablecontent d-flex flex-column" data-testid=@($"dnz-selector-popup-{DataControl.Token}") style="background:var(--rz-menu-background-color, white); max-height:min(60vh, 480px)">

		<div class="d-flex gap-2 flex-shrink-0">
			@if (DataControl.DropDowList != null && DataControl.DropDowList.Any()) {

			} else if (Client != null && DataControl.TokenList.IsNotEmpty()) {
				<RadzenIcon Icon="open_in_new" @onclick=@AbrirEnPopUp />
			}
			<RadzenTextBox @ref=@txtBoxSearch @onkeydown=@OnKeyDown @key=@(DataControl.Token + "-7") id=@("search" + idSeach) Placeholder="Escribe para buscar..." Style="width:100%;" @oninput=@(args => {
																																												  searchString = $"{args.Value}";
																																											  }) Value="@searchString" />
		</div>

		<div class="flex-grow-1 overflow-auto" style="min-height:0">
		@if (DataControl.DropDowList != null && DataControl.DropDowList.Any()) {
			<div class="dup_input dup_input_estandar d-flex flex-column dup_dropdown" style="width:350px">

				@foreach (var context in DataControl.DropDowList.Where((x) => x.Title.ContainsWebSearchMode(searchString))) {

					@* Ancla de test: la opcion se elige por su VALOR, nunca por el texto (que se
					   traduce). Misma convencion que las opciones de DnzEnumDropDown. Aqui el
					   testid puede ser fijo porque el popup ya se acota con
					   dnz-selector-popup-TOKEN, igual que se hace con las filas report-row-*.
					   La identidad y el valor guardado son el mismo dato, asi que va en los dos
					   atributos: data-testid-id (convencion de la casa) y data-value (el que
					   comparten todos los desplegables). *@
					<div class="d-flex p-1 align-content-center align-content-center dup_dropdownitem"
						 data-testid="dnz-selector-option"
						 data-testid-id=@context.Value
						 data-value=@context.Value
						 data-testname=@context.Title
						 @onclick=@((x) => SelectOrder(context))>
						<img src=@context.Icon width="24" style="margin-right:10px" onerror="this.src='https://dinaupcdn.com/up/202505/bullet.svg'" /> @context.Title
					</div>
				}

			</div>

		} else if (Client != null && DataControl.TokenList.IsNotEmpty()) {
			<DnzReportView Client="Client"
							  ReportId="@DataControl.TokenList"
							  QuerySearch="@searchString"
							  ShowTitle="false"
							  ShowSearch="false"
							  Limit="50"
							  Filtrable="false"
							  OnItemSelect="@(async (row) => await SelectOrder(row))" />
		}
		</div>
	</div>
</RadzenPopup>



@code {

	// ── Parameters ──
	[Parameter] public DinaupClientC Client { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.Control> OnDataControlChanged { get; set; }
	[Parameter] public Dinaup.VirtualFormDTO.Control DataControl { get; set; }
	[Parameter] public EventCallback<MouseEventArgs> ContextMenuAction { get; set; }
	[Parameter] public bool ModoCelda { get; set; }

	/// <summary>Lo emite DnzFormView al medir su contenedor. Ver alli el porque.</summary>
	[CascadingParameter(Name = "DnzFormMovil")] public bool Movil { get; set; }

	/// <summary>Movil de verdad para ESTE control: en una celda de sublista manda el modo celda.</summary>
	private bool EsMovil => Movil && ModoCelda == false;

	// ── Private fields ──
	RadzenTextBox txtBoxSearch;
	ElementReference elDivX;
	RadzenPopup popup;
	string searchString = "";
	private string idSeach = Guid.NewGuid().ToString().Replace("-", "");
	bool subiendoArchivo;
	double subiendoArchivoProgreso;
	DinaupFileDTO fileDTO;

	// ── Lifecycle ──

	protected override Task OnParametersSetAsync() {
		_ = actualizarInfoArchivoAsync();
		return base.OnParametersSetAsync();
	}

	public void Dispose() {
		if (DnzFormConfig.DeepDispose) {
			DataControl = null;
		}
	}

	// ── Popup ──

	void OpenPopup() {
		if (DataControl.IsLocked == false) {
			popup.ToggleAsync(elDivX);
		} else {
			NotificationService.Notify(NotificationSeverity.Warning, "Ups.", "Este campo no es editable.");
		}
	}

	async Task OnOpen() {
		if (DataControl.IsLocked == false)
			await JS.InvokeVoidAsync("eval", "setTimeout(function(){ document.getElementById('search" + idSeach + "').focus(); }, 300)");
	}

	async Task OnKeyDown(KeyboardEventArgs args) {
		// Keyboard navigation delegated to host via ReportSelectorTemplate
	}

	// ── Selection ──

	async Task SelectOrder(VirtualFormDTO.DropDownItem dataRow) {
		try { await popup.CloseAsync(); } catch { }
		await OnDataControlChanged.InvokeAsync(DataControl.WithValue(dataRow.Value).WithValueText(dataRow.Title).WithValueImageURL(dataRow.Icon));
	}

	async Task SelectOrder(DinaupDynamicRowDTO dataRow) {
		try { await popup.CloseAsync(); } catch { }
		await OnDataControlChanged.InvokeAsync(DataControl.WithValue(dataRow.ID).WithValueText(dataRow.Title).WithValueImageURL(dataRow.PreviewIMG));
	}

	async Task EliminarRelacion() {
		await OnDataControlChanged.InvokeAsync(DataControl.WithValue("").WithValueText(""));
	}

	async Task AbrirEnPopUp() {
		if (Client != null && DataControl.TokenList.IsNotEmpty()) {
			var selectedItem = await DnzItemPickerDialog.OpenAsync(DialogService, Client, DataControl.TokenList);
			if (selectedItem.IsNotNull())
				await this.SelectOrder(selectedItem);
		}
	}

	// ── Relation actions ──

	async Task AccederAsync() {
		if (Client == null) return;

		// La app host (play) puede tomar el control: p.ej. abrir el TPV (venta/compra/pedido/presupuesto)
		// en vez del formulario estandar. Si nadie lo intercepta, cae al formulario estandar de siempre.
		var req = new OpenRecordRequest {
			SectionId = DataControl.RelationWithSectionId,
			RowId = DataControl.Value,
			Title = DataControl.Value_Text ?? "",
			Client = Client
		};
		if (await Interceptor.TryOpenRecordAsync(req)) return;

		await DnzFormView.OpenAsync(DialogService, Client, DataControl.RelationWithSectionId, DataControl.Value);
	}

	async Task AgregarAsync() {
		try {
			if (Client == null) return;

			// La app host (play) puede tomar el control del alta POR SECCION: p.ej. abrir el TPV
			// (venta/compra/pedido/presupuesto) para crear el documento. En ese caso el registro se
			// crea por seccion, SIN token ni pre-enlace. Si nadie lo intercepta, cae al alta con
			// pre-enlace de siempre (OpenedFormAddRelation con el token del campo).
			var req = new OpenNewRecordRequest {
				SectionId = DataControl.RelationWithSectionId,
				Client = Client
			};
			if (await Interceptor.TryOpenNewRecordAsync(req)) return;

			var result = await Client.OpenedFormAddRelation(DataControl.RelationWithSectionId, DataControl.Token);
			var tokenForm = result?.TokenForm;
			if (tokenForm.IsNotEmpty()) {
				var options = new DialogOptions {
					WrapperCssClass = "dinaupdialogform",
					Width = "min(95%, 1806px)",
					Height = "90%",
					CloseDialogOnEsc = true,
					Resizable = true,
					Draggable = true,
					CloseDialogOnOverlayClick = false,
					ShowClose = false,
					ShowTitle = false
				};

				await DialogService.OpenAsync<DnzFormView>("", new Dictionary<string, object>
				{
					{ nameof(DnzFormView.Client), Client },
					{ nameof(DnzFormView.Token), tokenForm }
				}, options);
			}
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, "Ups.", ex.Message);
		}
	}

	// ── File upload ──

	void OnProgress(UploadProgressArgs args, string name) {
		if (args.Progress == 100) {
			subiendoArchivo = false;
			subiendoArchivoProgreso = 0;
			InvokeAsync(StateHasChanged);
		} else {
			subiendoArchivo = true;
			subiendoArchivoProgreso = args.Progress;
			InvokeAsync(StateHasChanged);
		}
	}

	async Task OnFilesComplete(List<DinaupFileDTO> files) {
		var x = files?.FirstOrDefault();
		if (x == null) return;
		try {
			await OnDataControlChanged.InvokeAsync(DataControl.WithValue(x.Id.STR()).WithValueText(x.Name));
			_ = actualizarInfoArchivoAsync();
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, ex.Message);
		}
		subiendoArchivo = false;
		_ = InvokeAsync(StateHasChanged);
	}

	void OnError(UploadErrorEventArgs args) {
		subiendoArchivo = false;
		InvokeAsync(StateHasChanged);
	}

	async Task actualizarInfoArchivoAsync() {
		if (fileDTO != null && fileDTO.Id.STR() == DataControl.Value)
			return;

		if (fileDTO != null && DataControl.Value.IsGUID() == false) {
			fileDTO = null;
			_ = InvokeAsync(StateHasChanged);
			return;
		}

		if (DataControl.InputType == "file" && Client != null) {
			if (DataControl.Value.IsGUID()) {
				FileResponse file = await Client.FileGetAsync(DataControl.Value.ToGUID());
				fileDTO = file.Files.Values.First();
				_ = InvokeAsync(StateHasChanged);
			}
		}
	}
}
