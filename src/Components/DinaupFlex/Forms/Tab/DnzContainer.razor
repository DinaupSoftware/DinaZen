@if (Container.IsNull()) return;

@* Style con mayuscula: DnzCard lo declara como parametro. En minuscula caeria en
   el splat de atributos y se emitiria dos veces sobre el mismo elemento. *@
<DnzCard @key=@(Container.Token + "1742963010") Style="@cardStyle" class="ctrlucont dnp-form-container">

	@if (Container.Icon.IsNotEmpty() && Movil == false)
	{
		@* En movil el icono no se pinta aqui: va en el titulo del bloque, que es en lo
		   que se convierte el contenedor. Este va posicionado en absoluto sobre la card. *@
		<div style="@iconStyle"></div>
	}

	@if ((Container.TokenList).IsNotEmpty())
	{
		@if (Container.Botones.IsNotEmpty())
		{
			<div style="height:calc(100% - 40px)">
				<DnzReportView ShowAdd=false Client=Client ReportId=@Container.TokenList />
			</div>

			<div class="pt-2">
				@foreach (var button in Container.Botones)
				{
					<DnzContainerButton OnMostrarDialogRequiereGuardar=@OnMostrarDialogRequiereGuardar @key=@(Container.Token + "-" + button.Id) Container=@Container OnButtonClick=@HandleOnButtonClick ButtonData="button" />
				}
			</div>
		}
		else
		{
			<DnzReportView Client=Client ReportId=@Container.TokenList />
		}
	}
	else if (Container.IsPrimaryList)
	{
		<DnzFormPrimaryList @key=@(Container.Token + "-plist")
						 OnDeleteItemPrimaryList="HandleOnDeleteItemPrimaryList"
						 OnTabChanged="HandleTabChanged"
						 OnAddItem="HandleNewItemList"
						 OnOpenListItem="OnOpenListItem"
						 Client="Client"
						 List="@Container.ParentForm.List" />
	}
</DnzCard>

@code {

	[Parameter] public EventCallback<string> OnMostrarDialogRequiereGuardar { get; set; }
	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }
	[Parameter] public EventCallback<string> OnButtonClick { get; set; }
	[Parameter, EditorRequired] public Dinaup.VirtualFormDTO.Container Container { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.Tab> OnTabChanged { get; set; }
	[Parameter] public EventCallback<string> OnDeleteItemPrimaryList { get; set; }
	[Parameter] public EventCallback OnAddItem { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.FormDetail> OnOpenListItem { get; set; }

	/// <summary>Lo emite DnzFormView al medir su contenedor. Ver alli el porque.</summary>
	[CascadingParameter(Name = "DnzFormMovil")] public bool Movil { get; set; }

	private string cardStyle = "";
	private string iconStyle = "";

	public void Dispose()
	{
		if (DnzFormConfig.DeepDispose)
		{
			Container = null;
		}
	}

	protected override void OnParametersSet()
	{
		if (Container.IsNull()) return;

		if (Movil)
		{
			// En movil aqui solo llegan contenedores de lista (informe o lista principal):
			// el resto se ha desmontado en campos. Ocupan el ancho entero y se les acota la
			// altura: la del servidor esta pensada para una pantalla de escritorio y tanto
			// se come el telefono entero como deja un grid de tres filas inservible.
			cardStyle = $"width: 100%; height: {Math.Min(Math.Max(Container.Height, 260), 420)}px;";
			iconStyle = "";
			return;
		}

		cardStyle = $"position: absolute; left: {Container.X}px; top: {Container.Y}px; width: {(Container.MaxWidth ? "calc(100% - 100px)" : $"{Container.Width}px")}; height: {Container.Height}px;";
		iconStyle = $"position: absolute; left: 30px; top: 0; width: 64px; height: {Container.Height}px; background-image: url('{Container.Icon}'); background-size: contain; background-repeat: no-repeat; background-position: center center;";
	}

	async Task HandleOnButtonClick(string id)
	{
		await OnButtonClick.InvokeAsync(id);
	}

	private Task HandleOnDeleteItemPrimaryList(string deleteId)
	{
		return OnDeleteItemPrimaryList.InvokeAsync(deleteId);
	}

	private Task HandleTabChanged(Dinaup.VirtualFormDTO.Tab updateTab)
	{
		return OnTabChanged.InvokeAsync(updateTab);
	}

	async Task HandleNewItemList()
	{
		await OnAddItem.InvokeAsync();
	}
}
