@if (Tab.TabName == "*")
{
	@if (Tab.ParentForm.MainTextGenerateOnSave == false && Tab.Controls.IsNotEmpty())
	{
		<RadzenTextBox Placeholder="Título" Disabled=Tab.Controls.First().IsLocked Change=@(args => HandleControlChanged(Tab.Controls.First().WithValue(args)))
					   data-fieldid="title"
					   data-testid="form-title"
					   @key=@(Tab.ParentForm.Token + Tab.Controls.First().Token + "-valor") Style="font-size:22px; width:90%;" Value=@Tab.Controls.First().Value class="w-100  obli" />
	}

}
else if (Movil)
{
	@* Movil: se abandonan las coordenadas y se apila en vertical, una fila por campo.
	   Quien decide el orden y los grupos es DnzFormMobileLayout: en el DTO los campos y
	   los contenedores son listas hermanas y planas, asi que la agrupacion que ve el
	   usuario hay que deducirla de la geometria. Aqui solo se pinta el resultado. *@
	@* Se conserva la clase base para no perder todo lo que ya cuelga de .dnp-form-tab
	   (botones, inputs); el modificador solo cambia la colocacion. *@
	<div class="dnp-form-tab dnp-form-tab-movil" @key=@(Tab.TabToken + "-movil")>

		@foreach (var grupo in DnzFormMobileLayout.Agrupar(Tab))
		{
			@* Ningun control se queda flotando sobre el fondo: todo grupo va dentro de una
			   caja. Sin etiquetas, esa caja ES la agrupacion. La de los campos es la card
			   (misma que en escritorio); la de una lista va desnuda, porque el DnzContainer
			   ya monta la suya y anidarlas daria caja dentro de caja. *@
			<div class="@(grupo.EsLista ? "dnz-grupo-lista" : "dnz-grupo")">

				@if (grupo.EsLista)
				{
					@* Un informe o la lista principal no se desmonta en campos: entero. *@
					<DnzContainer @key=@(grupo.Contenedor.Token + "-movil") OnButtonClick=HandleButtonClick OnMostrarDialogRequiereGuardar=HandleRequiereGuardar Container=grupo.Contenedor OnDeleteItemPrimaryList=HandleOnDeleteItemPrimaryList OnTabChanged=HandleTabChanged OnAddItem=HandleNewItemList OnOpenListItem=OnOpenListItem Client=Client />
				}
				else
				{
					@foreach (var control in grupo.Controles)
					{
						<DnzControl @key=@control.Token OnDataControlChanged=HandleControlChanged DataControl=control Client=Client OnFormatearCodigo=OnFormatearCodigo />
					}
				}

				@if (grupo.Botones.Count > 0)
				{
					<div class="dnz-grupo-botones">
						@foreach (var boton in grupo.Botones)
						{
							<DnzButton @key=@boton.Token OnMostrarDialogRequiereGuardar=HandleRequiereGuardar OnButtonClick=HandleButtonClick ButtonData=boton />
						}
					</div>
				}
			</div>
		}

	</div>
}
else
{

	<div class="dnp-form-tab" @key=@(Tab.TabToken + "-1742963288") style=@($"min-width:{Tab.Width.ToString()}px;height:{(Tab.Height + 10).ToString()}px; position:relative")>

		@foreach (var control in Tab.Containers.Values)
		{
			<DnzContainer @key=@control.Token OnButtonClick=HandleButtonClick OnMostrarDialogRequiereGuardar=HandleRequiereGuardar Container=control OnDeleteItemPrimaryList=HandleOnDeleteItemPrimaryList OnTabChanged=HandleTabChanged OnAddItem=HandleNewItemList OnOpenListItem=OnOpenListItem Client=Client />
		}

		@foreach (var currentControl in Tab.Controls ?? new())
		{
			<DnzControl @key=@currentControl.Token OnDataControlChanged=HandleControlChanged DataControl=currentControl Client=Client OnFormatearCodigo=OnFormatearCodigo />
		}

		@foreach (var currentButtom in Tab.Buttons ?? new())
		{
			<DnzButton @key=@currentButtom.Key OnMostrarDialogRequiereGuardar=HandleRequiereGuardar OnButtonClick=HandleButtonClick ButtonData=currentButtom.Value />
		}

	</div>


}


@code {

	[Parameter, EditorRequired] public Dinaup.VirtualFormDTO.Tab Tab { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.Tab> OnTabChanged { get; set; }
	[Parameter] public EventCallback<string> OnDeleteItemPrimaryList { get; set; }
	[Parameter] public EventCallback<string> OnButtonClick { get; set; }
	[Parameter] public EventCallback<string> OnMostrarDialogRequiereGuardar { get; set; }
	[Parameter] public EventCallback<Dinaup.VirtualFormDTO.FormDetail> OnOpenListItem { get; set; }

	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }
	[Parameter] public Func<string, Task<string>> OnFormatearCodigo { get; set; }

	/// <summary>Lo emite DnzFormView al medir su contenedor. Ver alli el porque.</summary>
	[CascadingParameter(Name = "DnzFormMovil")] public bool Movil { get; set; }



	public void Dispose()
	{

		if (DnzFormConfig.DeepDispose)
		{
			Tab = null;
		}
	}




	private Task HandleRequiereGuardar(string mensaje)
	{
		return OnMostrarDialogRequiereGuardar.InvokeAsync(mensaje);
	}

	private Task HandleButtonClick(string idOToken)
	{
		return OnButtonClick.InvokeAsync(idOToken);
	}

	private Task HandleOnDeleteItemPrimaryList(string deleteId)
	{
		return OnDeleteItemPrimaryList.InvokeAsync(deleteId);
	}


	private Task HandleControlChanged(Dinaup.VirtualFormDTO.Control updatedControl)
	{
		return OnTabChanged.InvokeAsync(Tab.WithUpdatedControl(updatedControl));	
	}

	private Task HandleTabChanged(Dinaup.VirtualFormDTO.Tab updateTab)
	{
		return OnTabChanged.InvokeAsync(updateTab);
	}

	[Parameter] public EventCallback OnAddItem { get; set; }



	async Task HandleNewItemList()
	{
		await OnAddItem.InvokeAsync();

	}
}
