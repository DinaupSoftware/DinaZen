@namespace DinaZen.Components.DinaupFlex.Forms
@implements IDisposable
@using static Dinaup.VirtualFormDTO


@if (FormList.IsNotNull())
{
	<div class="dnz-form-view dnz-form-mode-edit">

		<div class="dnz-form-header">
			<div class="dnz-form-header-info">
				@if (FormList.Section.IsNotNull() && FormList.Section.IconoID.IsNotEmpty())
				{
					<img src=@($"https://dinaupcdn.com/public/{FormList.Section.IconoID.STR()}.png") width="20px" height="20px" />
				}
				<span>@(FormList.Section.IsNotNull() ? FormList.Section.Label : "")</span>
				<RadzenBadge BadgeStyle="BadgeStyle.Info" Variant="Variant.Flat" Text="Editando" />
			</div>
			<div class="d-flex align-items-center gap-1">
				<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Dark" Variant="Variant.Text" Size="ButtonSize.Small" Click="Cerrar" Style="margin-left:12px; opacity:0.6" />
			</div>
		</div>

		<div class="dnz-form-mode-strip dnz-mode-edit"></div>

		<div class="dnz-form-title">
			@foreach (var tab in FormList.Tabs.Where(x => x.TabName == "*"))
			{
				<DnzFormTab @key=@($"dfl-{FormList.Token}-{tab.TabToken}-star")
							Tab="tab"
							OnTabChanged="HandleTabChange"
							Client="Client"
							OnFormatearCodigo="OnFormatearCodigo" />
			}
		</div>

		<div class="dnz-form-body">
			<RadzenTabs RenderMode="TabRenderMode.Server">
				<Tabs>
					@foreach (var tab in FormList.Tabs.Where(tab => tab.TabName != "*").OrderByDescending(tab => tab.TabName == "General"))
					{
						<RadzenTabsItem @key=@($"dfl-{FormList.Token}-{tab.TabToken}") Text="@tab.TabName">
							<DnzFormTab @key=@($"dfl-{FormList.Token}-{tab.TabToken}-tab")
										Tab="tab"
										OnTabChanged="HandleTabChange"
										Client="Client"
										OnFormatearCodigo="OnFormatearCodigo" />
						</RadzenTabsItem>
					}
				</Tabs>
			</RadzenTabs>
		</div>

		<div class="dnz-form-footer">
			<div></div>
			<div class="d-flex align-items-center gap-2">
				<RadzenButton ButtonStyle="ButtonStyle.Success" Icon="check" Text="Aceptar" Click="Cerrar" />
			</div>
		</div>
	</div>
}


@code {

	[Parameter, EditorRequired] public Dinaup.VirtualFormDTO.FormDetail FormList { get; set; }
	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }
	[Parameter] public Func<Dinaup.VirtualFormDTO.Tab, Task<Dinaup.VirtualFormDTO.FormDetail>> OnTabChangedAsync { get; set; }
	[Parameter] public Func<string, Task<string>> OnFormatearCodigo { get; set; }

	private bool isClosed = false;

	void Cerrar()
	{
		if (isClosed == false)
		{
			isClosed = true;
			DialogService.Close();
		}
	}

	async Task HandleTabChange(Dinaup.VirtualFormDTO.Tab newTab)
	{
		if (OnTabChangedAsync == null) return;
		try
		{
			var updatedFormDetail = await OnTabChangedAsync(newTab);
			if (updatedFormDetail.IsNotNull())
			{
				FormList = updatedFormDetail;
				await InvokeAsync(StateHasChanged);
			}
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	public void Dispose()
	{
		if (DnzFormConfig.DeepDispose)
			FormList = null;
	}
}
