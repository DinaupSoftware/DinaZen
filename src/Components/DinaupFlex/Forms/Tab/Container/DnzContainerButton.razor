<RadzenButton Click=OnClickAsync IsBusy=@_ejecutando Text=@ButtonData.Label style="@ButtonStyle" Size="ButtonSize.Small" @attributes="AdditionalAttributes">
</RadzenButton>

@code {


	[Parameter] public EventCallback<string> OnMostrarDialogRequiereGuardar { get; set; }

	[Parameter]
	public Dinaup.VirtualFormDTO.ContainerButton ButtonData { get; set; }

	[Parameter]
	public Dinaup.VirtualFormDTO.Container Container { get; set; }

	[Parameter]
	public EventCallback<string> OnButtonClick { get; set; }

	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }



	private string ButtonStyle { get; set; }

	protected override void OnParametersSet()
	{
		ButtonStyle = "";
	}


	// Mismo motivo que en DnzButton: detras hay un script y el viaje dura. Sin marcar ocupado
	// el boton sigue pulsable durante la ida y vuelta, y el script se ejecuta dos veces.
	private bool _ejecutando;

	async Task OnClickAsync()
	{
		if (_ejecutando) return;

		if (Container.ParentForm.ParentVirtualForm.HasChanged() && ButtonData.NeedSaveToClick)
		{
			await OnMostrarDialogRequiereGuardar.InvokeAsync("Se requiere guardar para ejecutar esta acción");
			return;
		}

		_ejecutando = true;
		try
		{
			await OnButtonClick.InvokeAsync(ButtonData.Id);
		}
		finally
		{
			_ejecutando = false;
		}
	}


	public void Dispose()
	{

		if (DnzFormConfig.DeepDispose)
		{
			ButtonData = null;
			Container = null;
		}
	}




}
