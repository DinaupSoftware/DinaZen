<RadzenButton data-fieldid=@ButtonData.FieldId data-testid=@ButtonData.Id @attributes="AdditionalAttributes" Click=OnClickAsync IsBusy=@_ejecutando Text=@ButtonData.Label @key=ButtonData.Token style="@ButtonStyle">
</RadzenButton>

@code {


    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

    [Parameter] public EventCallback<string> OnMostrarDialogRequiereGuardar { get; set; }

    [Parameter]
    public Dinaup.VirtualFormDTO.ControlButton ButtonData { get; set; }

    [Parameter]
    public EventCallback<string> OnButtonClick { get; set; }

    /// <summary>Lo emite DnzFormView al medir su contenedor. Ver alli el porque.</summary>
    [CascadingParameter(Name = "DnzFormMovil")] public bool Movil { get; set; }

    private string ButtonStyle { get; set; }

    protected override void OnParametersSet()
    {
        if (Movil)
        {
            // Sin coordenadas y con altura de dedo: en movil los botones se apilan al
            // final de su bloque, no van clavados sobre el lienzo.
            ButtonStyle = "padding: 1px;font-size: 12px;letter-spacing: 0.5px;min-height: 40px;";
            return;
        }

        ButtonStyle = $"position: absolute;padding: 1px;font-size: 11px;letter-spacing: 0.5px;" +
                      $"left: {ButtonData.X}px; " +
                      $"top: {ButtonData.Y}px;width: {ButtonData.Width}px;height: {ButtonData.Height}px;";
    }



    // Detras de este boton hay un script del servidor. Mientras va y vuelve el boton se marca
    // ocupado: Radzen lo deshabilita solo con IsBusy. Sin eso, el click no se esperaba y dos
    // pulsaciones seguidas ejecutaban el script dos veces (dos facturas, dos asientos...).
    private bool _ejecutando;

    async Task OnClickAsync()
    {
        if (_ejecutando) return;

        if (ButtonData.ParentForm.ParentVirtualForm.HasChanged() && ButtonData.NeedSaveToClick)
        {
            await OnMostrarDialogRequiereGuardar.InvokeAsync("Se requiere guardar para ejecutar esta acción");
            return;
        }

        _ejecutando = true;
        try
        {
            await OnButtonClick.InvokeAsync(ButtonData.Id);
        }
        finally
        {
            _ejecutando = false;
        }
    }


    public void Dispose()
    {

        if (DnzFormConfig.DeepDispose)
        {
            ButtonData = null;
        }
    }




}
