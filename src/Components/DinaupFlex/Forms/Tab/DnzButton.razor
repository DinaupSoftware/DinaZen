<RadzenButton data-fieldid=@ButtonData.FieldId data-testid=@ButtonData.Id @attributes="AdditionalAttributes" Click=OnClick Text=@ButtonData.Label @key=ButtonData.Token style="@ButtonStyle">
</RadzenButton>

@code {


    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

    [Parameter] public EventCallback<string> OnMostrarDialogRequiereGuardar { get; set; }

    [Parameter]
    public Dinaup.VirtualFormDTO.ControlButton ButtonData { get; set; }

    [Parameter]
    public EventCallback<string> OnButtonClick { get; set; }

    /// <summary>Lo emite DnzFormView al medir su contenedor. Ver alli el porque.</summary>
    [CascadingParameter(Name = "DnzFormMovil")] public bool Movil { get; set; }

    private string ButtonStyle { get; set; }

    protected override void OnParametersSet()
    {
        if (Movil)
        {
            // Sin coordenadas y con altura de dedo: en movil los botones se apilan al
            // final de su bloque, no van clavados sobre el lienzo.
            ButtonStyle = "padding: 1px;font-size: 12px;letter-spacing: 0.5px;min-height: 40px;";
            return;
        }

        ButtonStyle = $"position: absolute;padding: 1px;font-size: 11px;letter-spacing: 0.5px;" +
                      $"left: {ButtonData.X}px; " +
                      $"top: {ButtonData.Y}px;width: {ButtonData.Width}px;height: {ButtonData.Height}px;";
    }



    void OnClick()
    {

        if (ButtonData.ParentForm.ParentVirtualForm.HasChanged() &&   ButtonData.NeedSaveToClick)
        {
            OnMostrarDialogRequiereGuardar.InvokeAsync("Se requiere guardar para ejecutar esta acción");
        }else{
            OnButtonClick.InvokeAsync(ButtonData.Id);
        }



    }


    public void Dispose()
    {

        if (DnzFormConfig.DeepDispose)
        {
            ButtonData = null;
        }
    }




}
