@namespace DinaZen.Components.DinaupFlex.Reports
@using DinaZen.Components.DinaupFlex.Reports.Provider
@using DinaZen.Components.DinaupFlex.DnzResponseQuestions
@using DinaZen.Components.DinaupFlex.Reports.Filters
@inject DnzWindowManagerService WindowManager
@inject DnzInterceptorService Interceptor
@inject NavigationManager NavigationManager



@if (_isLoading && _dataList == null) {
	<div data-testid="report-loading">
		<DnzLoader />
	</div>
} else if (_showResponse && _report?.VariableList?.Variables != null) {
	<DnzResponseQuestions Variables="@_report.VariableList.Variables" VariableValues="@(VariablesValues ?? new())" Client="@Client" StorageKey="@ReportId" OnConfirm="@HandleVariableConfirm" />
} else if (_dataList != null) {
	<div class="dnz-report-view" data-testid="report-view" data-testid-id=@ReportId>
		@if (_isLoading || _typing) {
			<div class="dnz-report-loadbar" data-testid="report-loadbar"></div>

		}
		@if (ShowTitle || ShowSearch) {
			<div class="dnz-report-header">
				@if (ShowTitle && _dataList.Section.IsNotNull()) {
					<img onerror="this.src='https://dinaupcdn.com/up/202505/bullet.svg'" src="@($"https://dinaupcdn.com/public/{_dataList.Section.IconoID.STR()}.png")" width="33" height="33" style="border-radius:4px" />
				}
				@if (ShowTitle) {
					<span>@Title.IfIsEmpty(_dataList.Title)</span>
				}
				<div class="d-flex align-items-center gap-2 ms-auto" data-testid="report-toolbar">
					@if (ShowLoadTime && _lastLoadMs > 0) {
						<span class="text-muted small" data-testid="report-loadtime" title="Tiempo de la última carga (cliente · servidor).">@_lastLoadMs ms@(ServerMs > 0 ? $" · {ServerMs} srv" : "")</span>
						<RadzenButton data-testid="report-details" Visible=@(_dataList != null) Variant="Variant.Text" Icon="query_stats" Size="ButtonSize.Small" Click="@ShowDetailsAsync" title="Ver detalles (tiempos, SQL, metadatos)" />
					}
					<RadzenButton data-testid="report-add" Visible=@(ShowAdd && _dataList?.Section != null) Variant="Variant.Flat" ButtonStyle="ButtonStyle.Primary" Icon="add" Size="ButtonSize.Small" Click="@HandleAddClick" />
					@if (ShowSearch) {
						<DnzSearchInput data-testid="report-search" Value="@QuerySearch" BounceValueChanged="@UpdateSearchAsync" OnTyping="@OnSearchTyping" Placeholder="Buscar..." Style="max-width:300px" />
					}
					<RadzenButton data-testid="report-export" Variant="Variant.Text" Icon="file_download" Size="ButtonSize.Small" Click="@HandleExportClick" IsBusy=@_exporting title="Exportar CSV (todas las filas)" />
					<RadzenButton data-testid="report-refresh" Variant="Variant.Text" Icon="refresh" Size="ButtonSize.Small" Click="@(async () => await UpdateAsync())" />
				</div>
			</div>
		}

		<div class="dnz-report-body @(_loadSeq % 2 == 0 ? "dnz-anim-a" : "dnz-anim-b")">
			<RadzenDataGrid @ref="_gridRef"
				Data="@_rows" TItem="DinaupDynamicRowDTO" data-testid="report-grid"
				RowRender="@(a => a.Attributes.Add("data-testid", $"report-row-{a.Data.ID}"))" CellRender="@OnCellRender" AllowSorting="false"
				AllowFiltering="@Filtrable" AllowMultiColumnSorting="false" ShowMultiColumnSortingIndex="false"
				AllowColumnPicking="@ShowTitle" ColumnsShowingText="Columnas Visibles" AllColumnsText="Todas"
				AllowColumnReorder="true" AllowPaging="false" Density="Density.Compact"
				LoadData="@HandleLoadDataEvent"
				FilterMode="FilterMode.Advanced" FilterPopupRenderMode="PopupRenderMode.OnDemand" LogicalFilterOperator="LogicalFilterOperator.And"
				RowSelect="@HandleRowSelect" CellContextMenu="@OnCellContextMenu" AllowColumnResize="true"
				HeaderTemplate=@ToolBarTemplate KeyProperty="ID" SettingsChanged=@SaveSettingsAsync LoadSettings="@OnLoadSettings">

				<EmptyTemplate>
					<div class="dnz-report-empty" data-testid="report-empty">
						<RadzenIcon Icon="search_off" />
						<span>Sin resultados</span>
					</div>
				</EmptyTemplate>
				<Columns>

					@foreach (var col in _dataList.Columns.Where(c => !c.isColumnHidden)) {
						switch (col.Format) {
							case FieldFormatE.DEC when col.Role == RoleFieldE.Moneda:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-right text-nowrap" FooterCssClass="text-right text-nowrap">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										<DnzSpanMoney Amount="@row.GetDec(col.Keyword)" AutoColorRed=true />
									</Template>
									<FooterTemplate>
										@if (_rows.Count > 1) {
											<span>Suma: <b>@RegionService.ToStringDecimal(_rows.Sum(o => o.GetDec(col.Keyword)))</b></span>
										}
									</FooterTemplate>
								</RadzenDataGridColumn>
								break;

							case FieldFormatE.DEC:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-right text-nowrap" FooterCssClass="text-right text-nowrap">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										@if (col.Role == RoleFieldE.Minutos) {
											<DnzSpanMinutes Value=@row.GetDec(col.Keyword) />
										} else {
											<DnzSpanDecimal Value="@row.GetDec(col.Keyword)" />
										}
									</Template>
									<FooterTemplate>
										@if (_rows.Count > 1) {
											<span>Suma: <b>@RegionService.ToStringDecimal(_rows.Sum(o => o.GetDec(col.Keyword)))</b></span>
										}
									</FooterTemplate>
								</RadzenDataGridColumn>
								break;

							case FieldFormatE.INT:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-right text-nowrap" FooterCssClass="text-right text-nowrap">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										@if (col.Role == RoleFieldE.Minutos) {
											<DnzSpanMinutes Value=@((decimal?)row.GetInt(col.Keyword)) />
										} else {
											@row.GetLegible(col.Keyword)
										}
									</Template>
									<FooterTemplate>
										@if (_rows.Count > 1) {
											<span>Suma: <b>@_rows.Sum(o => (long)o.GetInt(col.Keyword))</b></span>
										}
									</FooterTemplate>
								</RadzenDataGridColumn>
								break;

							case FieldFormatE.DateAndTime:
							case FieldFormatE.DATE:
							case FieldFormatE.TIME:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-left text-nowrap">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										@{
											DateTime fecha = row.GetDateTime(col.Keyword);
										}
										@if (fecha != default) {
											@if (col.Format == FieldFormatE.DateAndTime) {
												<span>@RegionService.ToLocalFriendlyDateTime(fecha)</span>
											} else if (col.Format == FieldFormatE.DATE) {
												<span>@RegionService.ToLocalFriendlyDate(fecha)</span>
											} else {
												<span>@fecha.ToString("HH:mm")</span>
											}
										}
									</Template>
								</RadzenDataGridColumn>
								break;

							case FieldFormatE.BOOL:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-center">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										@if (row.GetBool(col.Keyword)) {
											<RadzenBadge Text="Si" BadgeStyle="BadgeStyle.Success" Shade="Shade.Light" />
										} else {
											<RadzenBadge Text="No" BadgeStyle="BadgeStyle.Danger" Shade="Shade.Light" />
										}
									</Template>
								</RadzenDataGridColumn>
								break;

							default:

								<RadzenDataGridColumn TItem="DinaupDynamicRowDTO" Title="@col.Label" Property="@RadzenReportQuery.PropExpr(col)" CssClass="text-left text-truncate">
									<FilterTemplate Context="data">
										<DnzFilter Column=@col DataColumn=@data />
									</FilterTemplate>
									<Template Context="row">
										@{
											var value = row.GetLegible(col.Keyword);
										}
										@if (value.IsNotEmpty()) {
											@if (col.BadgetsStyle.IsNotEmpty() || col.Predefined_Values.IsNotEmpty()) {
												<DnzBadgetAutoColor Value=@value BadgetStyle=col.BadgetsStyle />
											} else {
												@value
											}
										}
									</Template>
								</RadzenDataGridColumn>
								break;
						}
					}


				</Columns>
			</RadzenDataGrid>

			<div class="dnz-report-pager" data-testid="report-pager">
				<RadzenButton data-testid="report-prev" Variant="Variant.Text" Icon="chevron_left" Text="Anterior" Size="ButtonSize.Small" Disabled=@(_skip == 0 || _isLoading) Click="@(() => GoToPageAsync(-1))" />
				<span class="text-muted small" data-testid="report-pageinfo">Página @(_skip / _pageSize + 1) · @_rows.Count filas</span>
				<RadzenButton data-testid="report-next" Variant="Variant.Text" Icon="chevron_right" Text="Siguiente" Size="ButtonSize.Small" Disabled=@(!_hasNext || _isLoading) Click="@(() => GoToPageAsync(1))" />
				<span class="text-muted small ms-2">filas/página</span>
				<RadzenDropDown TValue="int" data-testid="report-pagesize" Data="@_pageSizeOptions" Value="@_pageSize" Change="@OnPageSizeChanged" Style="width:84px" Disabled=@_isLoading />
			</div>
		</div>
	</div>
} else if (_errorMessage.IsNotEmpty()) {
	<RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" data-testid="report-error">
		@_errorMessage
	</RadzenAlert>
}

@code {

	// ── Parametros ──
	[Parameter] public bool AdminMode { get; set; } = false;

	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }
	[Parameter, EditorRequired] public string ReportId { get; set; } = "";
	[Parameter] public Dictionary<string, string> VariablesValues { get; set; }
	[Parameter] public string QuerySearch { get; set; } = "";
	[Parameter] public List<FilterCondition> AdvancedFilter { get; set; }
	[Parameter] public int Limit { get; set; } = 25;
	[Parameter] public Dictionary<string, bool> Orden { get; set; }
	[Parameter] public bool ShowTitle { get; set; } = true;
	[Parameter] public string Title { get; set; } = "";
	[Parameter] public bool ShowSearch { get; set; } = true;
	[Parameter] public bool Filtrable { get; set; } = true;
	[Parameter] public bool ShowAdd { get; set; } = true;
	[Parameter] public bool ShowLoadTime { get; set; } = true;
	[Parameter] public RenderFragment ToolBarTemplate { get; set; }
	[Parameter] public EventCallback<DinaupDynamicRowDTO> OnItemSelect { get; set; }
	[Parameter] public EventCallback OnDataChanged { get; set; }

	// Hook opcional de cache. Lo rellena el consumidor (en play: ReportU): recibe la clave de la peticion, si es refresco forzado y la funcion de fetch real; decide si sirve de cache o va al servidor. Si es null, comportamiento identico al de siempre (passthrough).
	[Parameter] public Func<string, bool, Func<Task<Dinaup.ReportResponse>>, Task<Dinaup.ReportResponse>> FetchInterceptor { get; set; }

	// ── Estado ──

	private RadzenDataGrid<DinaupDynamicRowDTO> _gridRef;
	private DinaupReportDTO _report;
	private DinaupReportDataDTO _dataList;
	private List<DinaupDynamicRowDTO> _rows = new();
	// Offset de la página actual (0 = primera). La navegación es por OFFSET; el motor de informes lo capa a MaxRows (issue #26).
	private int _skip;
	// ¿La última ventana vino llena? ⇒ asumimos que hay página siguiente. Sin COUNT no hay total, así que ESTA es la señal de "Siguiente".
	private bool _hasNext;
	// Export en curso (recorre el informe en varias ventanas): feedback del botón.
	private bool _exporting;
	// Tamaño de página elegible por el usuario (selector de la barra). Arranca en Limit; gobierna la navegación prev/next.
	private int _pageSize;
	private bool _isLoading = true;
	// Buscando "en caliente": se enciende en la 1ª tecla del buscador (antes del debounce) y se apaga cuando UpdateSearchAsync resuelve. Solo gobierna la barrita azul, no la lógica de carga.
	private bool _typing;
	// Alterna par/impar en cada recarga de usuario (buscar/refrescar/toggle). El .razor.css usa la paridad para cambiar el animation-name y RE-DISPARAR el fade de fila aunque Radzen reutilice el <tr> (virtualización). En scroll NO se toca → sin parpadeo.
	private int _loadSeq;
	private bool _showResponse;
	private string _errorMessage = "";
	private long _lastLoadMs;
	private string _lastQuerySearch = "";
	private LoadDataReportC _lastFilter;
	// Tope de OFFSET de la paginación de informes (issue #26: el motor lo capa ahí). Acota tanto la profundidad navegable como el recorrido del export.
	private const int MaxRows = 50000;
	// Tamaño de cada ventana del export: recorre el informe por páginas (NO de golpe) hasta agotar o MaxRows.
	private const int ExportPageSize = 5000;
	// Opciones del selector "filas por página" de la barra (como el pager clásico).
	private static readonly IEnumerable<int> _pageSizeOptions = new int[] { 25, 50, 100, 250, 500, 1000, 3000 };
	// ── Settings (persistencia columnas visibles) ──

	// Flag de TEST: desactiva la persistencia de columnas/orden en localStorage. Sin ella no hay lectura JS al arrancar
	// ni reordenado de filas en la 2ª carga del grid → arranque más rápido y sin saltos. Solo para medir en pruebas.
	public static bool DisableLocalStorageSettings = true;

	private ReportGridSettingsStore _settingsStore;
	private string SettingsKey => $"dnz-report-{new Uri(NavigationManager.Uri).AbsolutePath}-{ReportId}";

	private Task SaveSettingsAsync(DataGridSettings x) => DisableLocalStorageSettings ? Task.CompletedTask : (_settingsStore ??= new ReportGridSettingsStore(JS, SettingsKey)).SaveAsync(x);
	private void OnLoadSettings(DataGridLoadSettingsEventArgs args) => args.Settings = (DisableLocalStorageSettings || _settingsStore == null) ? null : _settingsStore.Current;

	private ReportRequestParameters BaseRequest() => new(ReportId) { Variables = VariablesValues, QuerySearch = QuerySearch, Order = Orden, Expresion = AdvancedFilter, AdminMode = AdminMode };


	protected override async Task OnInitializedAsync() {
		_lastQuerySearch = QuerySearch ?? "";
		_pageSize = Limit > 0 ? Limit : 100;
	}

	protected override async Task OnAfterRenderAsync(bool firstRender) {
		if (firstRender)
		{
			await LoadDataAsync();

		}
	}

	protected override async Task OnParametersSetAsync() {
		var s = QuerySearch ?? "";
		if (s != _lastQuerySearch) {
			_lastQuerySearch = s;
			if (!_isLoading) { _loadSeq++; await LoadDataAsync(); }
		}
	}

	private void HandleVariableConfirm(Dictionary<string, string> v) {
		VariablesValues = v;
		_ = UpdateAsync();
	}

	// El debounce de DnzSearchInput dispara este callback desde un Task.Run (fuera del SynchronizationContext del circuito).
	// Envolvemos en InvokeAsync para correr TODO el flujo (incluida la continuación tras el await al servidor) en el hilo de Blazor:
	// así el setter de Data del grid y el repintado ocurren on-context, como en el scroll. Sin esto la 1ª búsqueda no repinta hasta hacer scroll.
	// Primera tecla en el buscador: enciende la barrita YA (sin esperar los 500ms del debounce). Se apaga en UpdateSearchAsync, busque o no.
	private void OnSearchTyping() { if (_typing) return; _typing = true; StateHasChanged(); }

	public Task UpdateSearchAsync(string query) => InvokeAsync(async () => {
		if (QuerySearch == query) { _typing = false; StateHasChanged(); return; } // tecleó y borró: no hay búsqueda real, pero hay que apagar la barrita
		QuerySearch = query;
		_loadSeq++;
		await LoadDataAsync();
		_typing = false;
		StateHasChanged();
	});

	public async Task UpdateAsync() { _loadSeq++; await LoadDataAsync(_lastFilter, force: true); }

	// ── Server-side LoadData ──

	// Navegación por páginas (nuestra barra prev/next): avanza/retrocede una ventana de _pageSize filas y recarga. Δ = +1 siguiente, -1 anterior.
	private async Task GoToPageAsync(int delta) {
		var next = _skip + delta * _pageSize;
		if (next < 0) next = 0;
		if (next >= MaxRows) return; // el motor capa el OFFSET a MaxRows (issue #26): no ofrecemos navegar más allá
		var cfg = new LoadDataReportC { Skip = next, Top = _pageSize };
		if (_lastFilter.IsNotNull()) { cfg.Filter = _lastFilter.Filter; cfg.Filters = _lastFilter.Filters; cfg.Sorts = _lastFilter.Sorts; cfg.OrderBy = _lastFilter.OrderBy; }
		_loadSeq++;
		await LoadDataAsync(cfg, force: true);
	}

	// Cambio del tamaño de página desde el selector: vuelve a la primera página con el nuevo tamaño, conservando filtro/orden.
	private async Task OnPageSizeChanged(object value) {
		_pageSize = (int)value;
		if (_pageSize <= 0) _pageSize = 100;
		_skip = 0;
		_loadSeq++;
		var cfg = new LoadDataReportC { Skip = 0, Top = _pageSize };
		if (_lastFilter.IsNotNull()) { cfg.Filter = _lastFilter.Filter; cfg.Filters = _lastFilter.Filters; cfg.Sorts = _lastFilter.Sorts; cfg.OrderBy = _lastFilter.OrderBy; }
		await LoadDataAsync(cfg, force: true);
	}

	// Tiempo total consumido EN el servidor (prep + Postgres + post), reportado por el SDK. 0 si no hay datos aún.
	private int ServerMs => _dataList == null ? 0 : _dataList.PrepareTimeMS + _dataList.DatabaseTimeMS + _dataList.PostProcessTimeMS;

	// Abre el dialog de detalles (desglose de tiempos, SQL ejecutado, metadatos) del último resultado cargado.
	private async Task ShowDetailsAsync() {
		if (_dataList == null) return;
		await DnzReportDebugDialog.OpenAsync(DialogService, _dataList, _lastLoadMs, ReportId);
	}

	private async Task HandleLoadDataEvent(LoadDataArgs args) {
		// La paginación la gobierna nuestra barra prev/next, no Radzen. Este evento solo llega por cambio de filtro: volvemos a la primera página con nuestro tamaño, conservando los filtros.
		var cfg = RadzenReportQuery.ToLoadConfig(args, _dataList);
		cfg.Skip = 0;
		cfg.Top = _pageSize;
		await LoadDataAsync(cfg);
		await InvokeAsync(StateHasChanged);
	}

	void OnCellRender(DataGridCellRenderEventArgs<DinaupDynamicRowDTO> args) {
		var prop = args.Column.Property.STR();
		if (prop.IsNotEmpty() && prop.Contains("[\"")) {
			var kw = Dinaup.extensions.ParseBetween(ref prop, "[\"", "\"]");
			if (kw.IsNotEmpty()) args.Attributes["data-testid"] = $"cell-{kw}";
		}
	}

	// ── Carga de datos ──
	// Anti-ráfaga: el RadzenDataGrid (y el Virtualize en fastMode) disparan LoadData varias veces al montar, y
	// OnInitialized ya hace una carga. Sin guarda, eso son ~5 Report_GetAsync solapados por cada apertura del informe.
	// Regla: una sola carga en vuelo; las que llegan mientras tanto quedan como "pendiente" (la última gana);
	// y una petición idéntica a la última ya servida no se repite. El refresh manual fuerza (force=true).

	private bool _loadInFlight;
	private LoadDataReportC _pendingFilter;
	private bool _pendingForce;
	private string _lastLoadedKey = "";

	// Identidad de la petición = el objeto completo que va al servidor (incluye búsqueda, filtros, orden, skip/top, variables).
	private static string FilterKey(ReportRequestParameters p) {
		try { return System.Text.Json.JsonSerializer.Serialize(p); } catch { return ""; }
	}

	private async Task LoadDataAsync(LoadDataReportC filter = null, bool force = false) {
		if (_pageSize <= 0) _pageSize = Limit > 0 ? Limit : 100;
		filter ??= new LoadDataReportC { Skip = 0, Top = _pageSize };

		var p = BaseRequest();
		p.ApplyLoadingConfiguration(filter);
		p.QuerySearch = this.QuerySearch;
		var key = ToSHA1( string.Join("¬", ReportId  ,    FilterKey(p) ,  this.QuerySearch , _pageSize  , p.CurrentPage) );
		p.GetPageSummary = false;
		if (!force && key.IsNotEmpty() && key == _lastLoadedKey) return;
		if (_loadInFlight) { _pendingFilter = filter; _pendingForce = force; return; }

		_loadInFlight = true;
		_lastFilter = filter;
		_isLoading = true;
		await InvokeAsync(StateHasChanged); // pinta la barrita de carga ANTES de la llamada al servidor (si no, _isLoading solo se vería ya en false al volver)
		_settingsStore ??= new ReportGridSettingsStore(JS, SettingsKey);
		if (DisableLocalStorageSettings == false) await _settingsStore.LoadAsync();

 


			var sw = System.Diagnostics.Stopwatch.StartNew();
			try {
				// Cache solo en la primera ventana (Skip==0): el caso "abrir la lista", el de alto reuso. Las páginas profundas van directas al server.
				var response = (FetchInterceptor != null && filter.Skip.GetValueOrDefault() == 0) ? await FetchInterceptor(key, force, () => Client.Report_GetAsync(p)) : await Client.Report_GetAsync(p);
				if (response.IsNotNull()) {
					var fetched = response.DataList?.GetDynamicsRowsOBJ()?.ToList() ?? new();
					var skip = filter.Skip.GetValueOrDefault();
					var top = filter.Top.GetValueOrDefault(_pageSize); if (top <= 0) top = _pageSize;

					// Ventana vacía pedida más allá del final (p.ej. "Siguiente" justo en un múltiplo exacto): no la pintamos, retrocedemos al offset anterior y plantamos el "no hay más".
					if (skip > 0 && fetched.Count == 0 && response.DataList.IsNotNull()) {
						_skip = Math.Max(0, skip - top);
						_hasNext = false;
					} else {
						_report = response.Report;
						_showResponse = response.DataList.IsNull();
						_dataList = response.DataList;
						_rows = fetched;
						_skip = skip;
						// Sin COUNT no hay total: ventana llena ⇒ probablemente haya página siguiente; corta ⇒ es el final. Y nunca más allá del tope de OFFSET del motor (issue #26).
						_hasNext = fetched.Count >= top && (skip + top) < MaxRows;

						if (OnDataChanged.HasDelegate)
							try { await OnDataChanged.InvokeAsync(); } catch { }
					}
				}
				_lastLoadedKey = key;
			} catch (Exception ex) { _errorMessage = ex.Message; } finally {
				_lastLoadMs = sw.ElapsedMilliseconds;
				_isLoading = false;
				_loadInFlight = false;
				await DrainPendingAsync();
			}


			await InvokeAsync(StateHasChanged);

	}

	// Sirve la última petición acumulada durante una carga en vuelo. Si resulta idéntica a la ya servida, el dedup de arriba la corta.
	private async Task DrainPendingAsync() {
		if (_pendingFilter.IsNull()) return;
		var pending = _pendingFilter;
		var force = _pendingForce;
		_pendingFilter = null;
		_pendingForce = false;
		await LoadDataAsync(pending, force);
	}

	// ── Export ──

	// Export del botón: recorre TODO el informe en ventanas (no de golpe) reutilizando GenerateCsvAsync, con feedback de ocupado porque son varias llamadas al servidor.
	private async Task HandleExportClick() {
		if (_exporting) return;
		_exporting = true;
		await InvokeAsync(StateHasChanged);
		try {
			var (csv, fileName, rowCount) = await GenerateCsvAsync();
			if (csv.IsEmpty()) { NotificationService.Notify(NotificationSeverity.Info, "Sin datos", "No hay filas que exportar."); return; }
			await DownloadCsvAsync(csv, fileName);
			NotificationService.Notify(NotificationSeverity.Success, "Exportado", $"{rowCount} filas.");
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, "Ups.", ex.Message, TimeSpan.FromSeconds(30));
		} finally {
			_exporting = false;
			await InvokeAsync(StateHasChanged);
		}
	}

	/// <summary>
	/// Recorre TODO el informe en ventanas por OFFSET (NO de golpe), conservando el filtro/orden activos, y serializa a CSV.
	/// Respeta el tope de OFFSET de MaxRows del motor (issue #26): más allá, hay que filtrar. Público para integraciones (ej: Yudo).
	/// </summary>
	public async Task<(string Csv, string FileName, int RowCount)> GenerateCsvAsync() {
		try {
			var all = new List<DinaupDynamicRowDTO>();
			DinaupReportDataDTO data = null;
			var skip = 0;
			while (skip < MaxRows) {
				var cfg = new LoadDataReportC { Skip = skip, Top = ExportPageSize };
				if (_lastFilter.IsNotNull()) { cfg.Filter = _lastFilter.Filter; cfg.Filters = _lastFilter.Filters; cfg.Sorts = _lastFilter.Sorts; cfg.OrderBy = _lastFilter.OrderBy; }
				var p = BaseRequest();
				p.ApplyLoadingConfiguration(cfg);
				p.QuerySearch = this.QuerySearch;
				p.GetPageSummary = false;
				var response = await Client.Report_GetAsync(p);
				var rows = response?.DataList?.GetDynamicsRowsOBJ()?.ToList() ?? new();
				if (response.IsNotNull() && response.DataList.IsNotNull()) data = response.DataList;
				if (rows.Count == 0) break;
				all.AddRange(rows);
				if (rows.Count < ExportPageSize) break; // última ventana
				skip += ExportPageSize;
			}
			if (data.IsNull()) return ("", "", 0);
			var columns = data.Columns.Where(c => !c.isColumnHidden).ToList();
			return ReportCsvExporter.Build(all, columns, Title.IfIsEmpty(_dataList?.Title));
		} catch { return ("", "", 0); }
	}

	private async Task DownloadCsvAsync(string csv, string fileName) {
		var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray();
		var base64 = Convert.ToBase64String(bytes);
		await JS.InvokeVoidAsync("eval", $"{{var a=document.createElement('a');a.href='data:text/csv;base64,{base64}';a.download='{fileName.Replace("'", "")}';document.body.appendChild(a);a.click();a.remove();}}");
	}

	// ── Acciones de fila ──

	private async Task HandleAddClick() {
		var sectionId = _dataList?.Section?.ID.STR();
		if (sectionId.IsEmpty()) return;

		if (await Interceptor.TryOpenNewRecordAsync(new OpenNewRecordRequest { SectionId = sectionId, Client = Client })) return;

		if (WindowManager != null)
			DnzFormView.OpenAsWindow(WindowManager, Client, sectionId, title: "Nuevo");
		else
			await DnzFormView.OpenAsync(DialogService, Client, sectionId, title: "Nuevo");
	}

	private async Task HandleRowSelect(DinaupDynamicRowDTO row) {
		if (OnItemSelect.HasDelegate) {
			await OnItemSelect.InvokeAsync(row);
			return;
		}

		if (string.IsNullOrEmpty(row.SectionId)) return; // informes agrupados no tienen seccion

		if (await Interceptor.TryOpenRecordAsync(new OpenRecordRequest { SectionId = row.SectionId, RowId = row.ID, Title = row.Title ?? "", Client = Client })) return;

		// Comportamiento por defecto: abrir formulario en ventana flotante
		if (WindowManager != null)
			DnzFormView.OpenAsWindow(WindowManager, Client, row.SectionId, row.ID, title: row.Title ?? "Formulario");
		else
			await DnzFormView.OpenAsync(DialogService, Client, row.SectionId, row.ID);
	}

	// ── Context menu (click derecho) ──

	private DinaupDynamicRowDTO _contextRow;

	void OnCellContextMenu(DataGridCellMouseEventArgs<DinaupDynamicRowDTO> args) {
		if (_dataList?.Section == null || string.IsNullOrEmpty(args.Data?.SectionId)) return;
		_contextRow = args.Data;
		var items = new List<ContextMenuItem>();
		if (_dataList.CanDelete)
			items.Add(new ContextMenuItem { Text = "Eliminar", Icon = "delete", IconColor = "red", Value = "delete" });
		if (items.IsNotEmpty())
			ContextMenuService.Open(args, items, OnContextMenuClick);
	}

	void OnContextMenuClick(MenuItemEventArgs args) {
		ContextMenuService.Close();
		if (args.Value?.ToString() == "delete") _ = DeleteRowAsync();
	}

	async Task DeleteRowAsync() {
		if (_contextRow == null) return;
		try {
			var values = new Dictionary<string, string> { { "id", _contextRow.ID }, { "eliminado", "1" } };
			var wo = new WriteOperation(_contextRow.ID, values);
			var result = await Client.RunWriteOperationAsync(_contextRow.SectionId.ToGUID(), wo, false);
			result.EnsureSuccess();
			_rows.Remove(_contextRow);
			_contextRow = null;
			await InvokeAsync(StateHasChanged);
			NotificationService.Notify(NotificationSeverity.Success, "Genial", "El registro se ha eliminado correctamente.");
			if (OnDataChanged.HasDelegate) await OnDataChanged.InvokeAsync();
		} catch (Exception ex) {
			NotificationService.Notify(NotificationSeverity.Error, "Ups.", ex.Message, TimeSpan.FromSeconds(30));
		}
	}

	// ── Helpers estaticos para abrir ──

	public static async Task OpenAsync(DialogService ds, DinaupClientC client, string reportId, Dictionary<string, string> vars = null, string title = "Informe", string width = "90%", string height = "80%") {
		var p = new Dictionary<string, object> { { nameof(Client), client }, { nameof(ReportId), reportId } };
		if (vars != null) p.Add(nameof(VariablesValues), vars);

		await ds.OpenAsync<DnzReportView>(title, p, new DialogOptions { Width = width, Height = height, CloseDialogOnEsc = true, Resizable = true, Draggable = true, ShowClose = true, ShowTitle = true });
	}

	public static string OpenAsWindow(DnzWindowManagerService wm, DinaupClientC client, string reportId, Dictionary<string, string> vars = null, string title = "Informe", string icon = "analytics") {
		RenderFragment content = b => {
			b.OpenComponent<DnzReportView>(0);
			b.AddAttribute(1, nameof(Client), client);
			b.AddAttribute(2, nameof(ReportId), reportId);
			if (vars != null) b.AddAttribute(3, nameof(VariablesValues), vars);
			b.CloseComponent();
		};
		return wm.Open(new WindowOptions { Title = title, Icon = icon, InitialWidth = 1100, InitialHeight = 650 }, content);
	}
}
