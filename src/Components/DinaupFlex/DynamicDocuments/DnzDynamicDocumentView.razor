@namespace DinaZen.Components.DinaupFlex.DynamicDocuments
@using DinaZen.Components.DinaupFlex.DnzResponseQuestions
@inject DnzInterceptorService Interceptor

<DnzDialogLayout>
	<TitleContent>
		@(_docInfo?.Name ?? "Documento")
	</TitleContent>
	<BodyContent>
		<div style="display:flex; flex-direction:column; height:100%; overflow:hidden">
			@if (Embedded == false && (CompatibleDocuments.IsNotEmpty() || Destinatario.IsNotEmpty()))
			{
				<div class="d-flex align-items-center gap-2 p-2" style="border-bottom:1px solid var(--rz-base-300); flex-shrink:0">
					@if (CompatibleDocuments.IsNotEmpty())
					{
						<RadzenIcon Icon="description" Style="color:var(--rz-primary); font-size:18px" />
						<RadzenDropDown AllowFiltering="true"
										FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
										FilterOperator="StringFilterOperator.Contains"
										@bind-Value="@DocId"
										@bind-Value:after="@UpdateAsync"
										TValue="string"
										ValueProperty="@nameof(DinaupDynamicDocumentDTO.IDSTR)"
										TextProperty="@nameof(DinaupDynamicDocumentDTO.Title)"
										Data="@CompatibleDocuments"
										Style="flex:1; max-width:400px"
										Placeholder="Seleccionar plantilla..." />
					}
					@* El usuario ve a quien va el email ANTES de pulsar enviar, no en el paso siguiente *@
					@if (Destinatario.IsNotEmpty())
					{
						<div class="d-flex align-items-center gap-1 ms-auto" title="@_lastResponse?.Email_Destinatario">
							<RadzenIcon Icon="alternate_email" Style="color:var(--rz-text-secondary-color); font-size:18px" />
							<span class="rz-text-caption">@Destinatario</span>
						</div>
					}
				</div>
			}

			<div style="flex:1; overflow:auto; display:flex; justify-content:center">
				@if (_isLoading)
				{
					<div style="display:flex; align-items:center; justify-content:center; width:100%">
						<DnzLoader />
					</div>
				}
				else if (_requiresVariables && _docInfo?.Questions?.Variables != null)
				{
					<DnzResponseQuestions Variables="@_docInfo.Questions.Variables"
									  VariableValues="@VariableValues"
									  FixedKeys="@_clavesDelLlamador"
									  Client="@Client"
									  StorageKey="@DocId"
									  OnConfirm="@HandleVariableConfirm" />
				}
				else if (_documentContent.IsNotEmpty())
				{
					<iframe id="@_iframeId" style="width:100%; max-width:900px; height:100%; border:none; border-radius:6px" />
				}
				else if (_errorMessage.IsNotEmpty())
				{
					<div class="p-3" style="width:100%">
						<RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter">
							@_errorMessage
						</RadzenAlert>
					</div>
				}
			</div>
		</div>
	</BodyContent>
	<FooterContent>
		@* Embebido (panel de dashboard, pantalla de cobro) el visor es solo lectura:
		   ni enviar ni cerrar tienen sentido dentro de otra ventana que ya tiene sus acciones. *@
		@if (Embedded == false)
		{
			<div class="d-flex justify-content-between w-100">
				<div class="d-flex gap-2">
					@if (_documentContent.IsNotEmpty())
					{
						<RadzenButton Icon="print" Text="Imprimir" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Text"
									  Click="@PrintDocument" />
						@* Un solo boton: adjuntar o no, y email o firma, es fontaneria interna que decide
						   la plantilla (ver EnviaConAdjunto y PideFirma), no el usuario *@
						@if (PideFirma)
						{
							<RadzenButton Icon="draw" Text=@(_firmaSolicitada ? "Enviado a firmar" : "Enviar a firmar")
										  ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
										  Disabled=@(PuedeFirmar == false || _firmaSolicitada)
										  IsBusy=@_isSendingEmail Click="@HandleRequestSign" />
						}
						else if (PuedeEnviarEmail)
						{
							<RadzenButton Icon="send" Text="Enviar por email" ButtonStyle="ButtonStyle.Info" Variant="Variant.Text"
										  IsBusy=@_isSendingEmail Click="@HandleSendEmail" />
						}
					}
				</div>
				<RadzenButton Icon="close" Text="Cerrar" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text"
							  Click="@(() => DialogService.Close())" />
			</div>
		}
	</FooterContent>
</DnzDialogLayout>

@code {

	/// <summary>
	/// Cliente DinaupSL (no requerido si se usa PreloadedResult).
	/// </summary>
	[Parameter] public DinaupClientC Client { get; set; }

	/// <summary>
	/// ID del documento dinamico (no requerido si se usa PreloadedResult).
	/// </summary>
	[Parameter] public string DocId { get; set; } = "";

	/// <summary>
	/// Resultado pre-cargado. Si se proporciona, no ejecuta la API.
	/// </summary>
	[Parameter] public DynamicDocumentsGetResponse PreloadedResult { get; set; }

	/// <summary>
	/// Variables para la ejecucion del documento.
	/// </summary>
	[Parameter] public Dictionary<string, string> VariableValues { get; set; } = new();

	/// <summary>
	/// Lista de documentos compatibles (para selector dropdown).
	/// </summary>
	[Parameter] public List<DinaupDynamicDocumentDTO> CompatibleDocuments { get; set; }

	/// <summary>
	/// Si true, lanza print automaticamente al cargar.
	/// </summary>
	[Parameter] public bool AutoPrint { get; set; }

	/// <summary>
	/// El visor se renderiza dentro de otra ventana (panel de dashboard, pantalla de cobro):
	/// oculta cabecera y footer para no ofrecer acciones que no vienen a cuento.
	/// </summary>
	[Parameter] public bool Embedded { get; set; }

	/// <summary>
	/// Evento para enviar el documento por email (HTML como cuerpo).
	/// </summary>
	[Parameter] public EventCallback<DinaupDocumentRequest> OnSendEmail { get; set; }

	/// <summary>
	/// Evento para enviar el documento por email con PDF adjunto.
	/// </summary>
	[Parameter] public EventCallback<DinaupDocumentRequest> OnSendEmailWithAttachment { get; set; }


	private DynamicDocumentsGetResponse _lastResponse;
	private DynamicDocumentsGetResponse.DDocumentC _docInfo;
	private string _documentContent = "";
	private bool _requiresVariables = false;

	/// <summary>
	/// Variables que trajo puestas quien abrio el documento (el registro de la ficha, el ticket del
	/// TPV). Se capturan ANTES de la primera respuesta del usuario, que reescribe el diccionario, y
	/// son las que el panel de preguntas no tiene que volver a pedir.
	/// </summary>
	private HashSet<string> _clavesDelLlamador;
	private bool _isLoading = true;
	private string _errorMessage = "";
	private bool _isSendingEmail = false;
	private string _iframeId = $"dnz-doc-{Guid.NewGuid():N}";

	// El callback por parametro manda; si no viene, se usa el que haya registrado la app host
	// en el interceptor. Asi el email esta disponible en TODAS las vias de apertura del visor
	// (dialog, ventana, render inline) sin que cada una tenga que cablearlo.
	private bool HayEnvioComoCuerpo => OnSendEmail.HasDelegate || Interceptor.CanSendDocumentEmail;

	private bool HayEnvioConAdjunto => OnSendEmailWithAttachment.HasDelegate || Interceptor.CanSendDocumentEmailWithAttachment;

	private bool PuedeEnviarEmail => HayEnvioComoCuerpo || HayEnvioConAdjunto;

	/// <summary>
	/// La plantilla marca el documento como "para firmar" (email_sign). Firmar y enviar por email
	/// son destinos EXCLUYENTES: el aviso al firmante lo manda el propio servicio de firma, asi que
	/// ofrecer ademas el email seria un segundo envio distinto del mismo documento. Por eso un
	/// documento marcado para firmar NO cae al boton de email aunque el host no sepa firmar:
	/// mandarlo por correo suelto seria dar por hecho un tramite que no ha ocurrido.
	/// </summary>
	private bool PideFirma => DinaupDocumentRequest.EsVerdadero(Metadato(DinaupDocumentRequest.ClaveSign));

	private bool PuedeFirmar => PideFirma && Interceptor.CanRequestSign;

	/// <summary>Ya se creo la peticion de firma: repetirla mandaria un segundo aviso al firmante.</summary>
	private bool _firmaSolicitada;

	/// <summary>
	/// Que la plantilla defina un texto de acompanamiento significa que el documento va ADJUNTO
	/// y ese texto es el cuerpo. Sin el, el documento ES el cuerpo. Lo decide la plantilla,
	/// no el usuario: distinguirlo a mano obligaria a entender como funciona esto por dentro.
	/// </summary>
	private bool EnviaConAdjunto => (_lastResponse?.Email_Body).IsNotEmpty() && HayEnvioConAdjunto;

	private string Destinatario
	{
		get
		{
			if (PuedeEnviarEmail == false && PideFirma == false) return "";
			string nombre = _lastResponse?.Email_Destinatario_Nombre ?? "";
			return nombre.IsNotEmpty() ? nombre : (_lastResponse?.Email_Destinatario ?? "");
		}
	}

	protected override async Task OnInitializedAsync()
	{
		if (PreloadedResult != null)
		{
			_lastResponse = PreloadedResult;
			_docInfo = PreloadedResult.DynamicDocument;
			_documentContent = PreloadedResult.Content ?? "";
			_isLoading = false;
		}
		else
		{
			await UpdateAsync();
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender && _documentContent.IsNotEmpty())
		{
			try
			{
				await JS.InvokeVoidAsync("DinaZen.setIframeBlob", _iframeId, _documentContent);
				if (AutoPrint)
					await JS.InvokeVoidAsync("DinaZen.printIframe", _iframeId);
			}
			catch { }
		}
	}

	private void HandleVariableConfirm(Dictionary<string, string> variableValues)
	{
		VariableValues = variableValues;
		_ = UpdateAsync();
	}

	public async Task UpdateAsync()
	{
		_isLoading = true;
		_errorMessage = "";
		_requiresVariables = false;
		_documentContent = "";
		_firmaSolicitada = false;   // otra plantilla es otro documento: aun no se ha mandado a firmar
		StateHasChanged();

		try
		{
			_clavesDelLlamador ??= VariableValues.IsEmpty()
				? new HashSet<string>(StringComparer.OrdinalIgnoreCase)
				: new HashSet<string>(VariableValues.Keys, StringComparer.OrdinalIgnoreCase);

			var sendVar = new Dictionary<string, string>();

			if (CompatibleDocuments.IsNotEmpty())
			{
				foreach (var currentDocument in CompatibleDocuments)
				{
					if (currentDocument.VariableList.IsNull() || currentDocument.VariableList.Variables.IsEmpty()) continue;
					string actualKey = currentDocument.VariableList.Variables.Keys.First();
					if (!sendVar.ContainsKey(actualKey))
						sendVar.Add(actualKey, VariableValues?.Values?.FirstOrDefault() ?? "");
				}
			}

			if (sendVar.IsEmpty() && VariableValues.IsNotEmpty())
				sendVar = VariableValues;

			var response = sendVar.IsNotEmpty()
				? await Client.DynamicDocuments_ExecuteAsync(DocId, sendVar)
				: await Client.DynamicDocuments_ExecuteAsync(DocId);

			_lastResponse = response;
			_docInfo = response.DynamicDocument;
			_documentContent = response.Content ?? "";

			if (response.Status == 3) // RequiresAsResponse
			{
				// Lo que trajo el llamador NO se tira: es la semilla del panel. Vaciarlo aqui hacia
				// que, en un documento con dos o mas variables, el usuario tuviera que volver a
				// elegir a mano el registro cuya ficha tenia abierta, con el riesgo de elegir otro
				// distinto y dejar el documento y el registro de la accion en clientes diferentes.
				_requiresVariables = true;
			}
		}
		catch (Exception ex)
		{
			_errorMessage = ex.Message;
		}
		finally
		{
			_isLoading = false;
			StateHasChanged();
		}

		if (_documentContent.IsNotEmpty())
		{
			try
			{
				await JS.InvokeVoidAsync("DinaZen.setIframeBlob", _iframeId, _documentContent);
				if (AutoPrint)
					await JS.InvokeVoidAsync("DinaZen.printIframe", _iframeId);
			}
			catch { }
		}
	}

	private async Task PrintDocument()
	{
		try
		{
			await JS.InvokeVoidAsync("DinaZen.printIframe", _iframeId);
		}
		catch (Exception ex)
		{
			NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
		}
	}

	private DinaupDocumentRequest BuildEmailRequest()
	{
		var request = new DinaupDocumentRequest
		{
			DocumentHtml = _documentContent,
			DocumentTitle = _docInfo?.Name ?? "",
			VariableValues = VariableValues ?? new()
		};

		if (_lastResponse == null) return request;

		// Todo lo que puso el script, tal cual: un metadato nuevo llega al host sin tocar DinaZen.
		if (_lastResponse.Metadata != null)
		{
			foreach (var metadato in _lastResponse.Metadata)
				request.Metadata[metadato.Key] = metadato.Value;
		}

		// Las claves con varios alias (email_asunto/email_subject, los cinco del destinatario...)
		// las resuelve el cliente: se vuelcan ya normalizadas para que el host lea siempre la misma.
		Normalizar(request, DinaupDocumentRequest.ClaveFromEmail, _lastResponse.Email_From);
		Normalizar(request, DinaupDocumentRequest.ClaveFromName, _lastResponse.Email_FromName);
		Normalizar(request, DinaupDocumentRequest.ClaveToEmail, _lastResponse.Email_Destinatario);
		Normalizar(request, DinaupDocumentRequest.ClaveToName, _lastResponse.Email_Destinatario_Nombre);
		Normalizar(request, DinaupDocumentRequest.ClaveSubject, _lastResponse.Email_Asunto);
		Normalizar(request, DinaupDocumentRequest.ClaveEmailBody, _lastResponse.Email_Body);
		Normalizar(request, DinaupDocumentRequest.ClaveFileName, _lastResponse.FileName);

		return request;
	}

	private static void Normalizar(DinaupDocumentRequest request, string clave, string valor)
	{
		if (valor.IsEmpty()) return;
		request.Metadata[clave] = valor;
	}

	/// <summary>Lee un metadato crudo del documento, antes de construir el request.</summary>
	private string Metadato(string clave)
	{
		var metadatos = _lastResponse?.Metadata;
		if (metadatos == null) return "";
		return metadatos.TryGetValue(clave, out string valor) ? (valor ?? "") : "";
	}

	private async Task HandleRequestSign()
	{
		if (_docInfo == null || _documentContent.IsEmpty() || PuedeFirmar == false || _isSendingEmail) return;

		// Generar el PDF tarda, asi que el usuario tiene que ver el boton ocupado
		_isSendingEmail = true;
		StateHasChanged();
		try
		{
			_firmaSolicitada = await Interceptor.RequestSignAsync(BuildEmailRequest());
		}
		finally
		{
			_isSendingEmail = false;
			StateHasChanged();
		}
	}

	private async Task HandleSendEmail()
	{
		if (_docInfo == null || _documentContent.IsEmpty() || PuedeEnviarEmail == false || _isSendingEmail) return;

		_isSendingEmail = true;
		StateHasChanged();
		try
		{
			// Generar el PDF tarda, asi que el usuario tiene que ver el boton ocupado
			if (EnviaConAdjunto)
				await EnviarConAdjuntoAsync();
			else
				await EnviarComoCuerpoAsync();
		}
		finally
		{
			_isSendingEmail = false;
			StateHasChanged();
		}
	}

	private async Task EnviarConAdjuntoAsync()
	{
		if (OnSendEmailWithAttachment.HasDelegate)
			await OnSendEmailWithAttachment.InvokeAsync(BuildEmailRequest());
		else
			await Interceptor.SendDocumentEmailWithAttachmentAsync(BuildEmailRequest());
	}

	private async Task EnviarComoCuerpoAsync()
	{
		// Si la app host solo sabe enviar con adjunto, mejor eso que no enviar nada
		if (HayEnvioComoCuerpo == false)
		{
			await EnviarConAdjuntoAsync();
			return;
		}

		if (OnSendEmail.HasDelegate)
			await OnSendEmail.InvokeAsync(BuildEmailRequest());
		else
			await Interceptor.SendDocumentEmailAsync(BuildEmailRequest());
	}

	// ── Static helper para abrir como modal ──

	public static async Task OpenAsync(
		DialogService dialogService,
		DinaupClientC client,
		string docId,
		Dictionary<string, string> variableValues = null,
		List<DinaupDynamicDocumentDTO> compatibleDocuments = null,
		EventCallback<DinaupDocumentRequest>? onSendEmail = null,
		EventCallback<DinaupDocumentRequest>? onSendEmailWithAttachment = null,
		string width = "85%",
		string height = "80%")
	{
		var parameters = new Dictionary<string, object>
		{
			{ nameof(Client), client },
			{ nameof(DocId), docId }
		};

		if (variableValues != null)
			parameters.Add(nameof(VariableValues), variableValues);
		if (compatibleDocuments != null)
			parameters.Add(nameof(CompatibleDocuments), compatibleDocuments);
		if (onSendEmail.HasValue)
			parameters.Add(nameof(OnSendEmail), onSendEmail.Value);
		if (onSendEmailWithAttachment.HasValue)
			parameters.Add(nameof(OnSendEmailWithAttachment), onSendEmailWithAttachment.Value);

		var options = new DialogOptions
		{
			Width = width,
			Height = height,
			CloseDialogOnEsc = true,
			Resizable = true,
			Draggable = true,
			ShowClose = false,
			ShowTitle = false
		};

		await dialogService.OpenAsync<DnzDynamicDocumentView>(null, parameters, options);
	}

	/// <summary>
	/// Abre un resultado ya ejecutado como modal (reemplaza DynamicDocumentResultDialog).
	/// </summary>
	public static async Task OpenPreloadedAsync(
		DialogService dialogService,
		DynamicDocumentsGetResponse result,
		string title = "Documento",
		string width = "80%",
		string height = "90%")
	{
		var parameters = new Dictionary<string, object>
		{
			{ nameof(PreloadedResult), result }
		};

		var options = new DialogOptions
		{
			Width = width,
			Height = height,
			CloseDialogOnEsc = true,
			Resizable = true,
			Draggable = true,
			ShowClose = false,
			ShowTitle = false
		};

		await dialogService.OpenAsync<DnzDynamicDocumentView>(null, parameters, options);
	}

	// ── Static helper para abrir como ventana ──

	public static string OpenAsWindow(
		DnzWindowManagerService windowManager,
		DinaupClientC client,
		string docId,
		Dictionary<string, string> variableValues = null,
		List<DinaupDynamicDocumentDTO> compatibleDocuments = null,
		string title = "Documento",
		string icon = "description")
	{
		RenderFragment content = builder =>
		{
			builder.OpenComponent<DnzDynamicDocumentView>(0);
			builder.AddAttribute(1, nameof(Client), client);
			builder.AddAttribute(2, nameof(DocId), docId);
			if (variableValues != null)
				builder.AddAttribute(3, nameof(VariableValues), variableValues);
			if (compatibleDocuments != null)
				builder.AddAttribute(4, nameof(CompatibleDocuments), compatibleDocuments);
			builder.CloseComponent();
		};

		var options = new WindowOptions
		{
			Title = title,
			Icon = icon,
			InitialWidth = 1020,
			InitialHeight = 650
		};

		return windowManager.Open(options, content);
	}
}
