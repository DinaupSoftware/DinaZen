@namespace DinaZen.Components.DinaupFlex.Annotations

<div class="d-flex gap-1" @attributes="AdditionalAttributes">
	<DnzCard Variant="Variant.Outlined" class="flex-grow-1">
		<h6 class="mb-2">Agregar un comentario</h6>
		<RadzenTextArea @bind-Value=@mensaje Placeholder="Escribe un comentario..." Style="min-height: 100px; width: 100%;" data-testid="modern-compose-textarea" />
		<div class="d-flex justify-content-end mt-2">
			<RadzenButton Icon="send" Text="Comentar" Click=@GuardarComentarioAsync IsBusy=@enviando Variant="Variant.Text" data-testid="modern-compose-send" />
		</div>
	</DnzCard>
</div>


@code {

	[Parameter, EditorRequired] public Dinaup.DinaupClientC Client { get; set; }
	[Parameter] public Dictionary<string, string> MencionesDisponibles { get; set; } = new();
	[Parameter] public EventCallback ComentarioEnviado { get; set; }
	[Parameter] public System.Guid RowId { get; set; }
	[Parameter] public System.Guid SectionId { get; set; }
	[Parameter] public Dinaup.AnnotationTypeE Type { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }
	public string mensaje;
	private bool enviando;

	async Task GuardarComentarioAsync()
	{
		if (mensaje.IsEmpty())
		{
			NotificationService.Notify(Radzen.NotificationSeverity.Warning, "Comentario vacío", "Escribe un comentario antes de enviar");
			return;
		}

		enviando = true;
		try
		{
			await Client.Annotation_PutAsync((new Dinaup.AnotationParameters(SectionId, RowId, Type)).WithText(mensaje));

			mensaje = "";

			// El comentario ya se guardó: un fallo del callback del padre no debe mostrarse como error de guardado.
			try
			{
				if (ComentarioEnviado.HasDelegate)
					await ComentarioEnviado.InvokeAsync();
			}
			catch { }
		}
		catch (Exception ex)
		{
			NotificationService.Notify(Radzen.NotificationSeverity.Error, "Error", ex.Message);
		}
		finally
		{
			enviando = false;
		}
	}
}
