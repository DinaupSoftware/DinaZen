@namespace DinaZen.Components.DinaupFlex.Components
@using Radzen.Blazor.Rendering
@inject DnzWindowManagerService _windowManager


<ErrorBoundary>
	<div class=@(_isCompact ? "dnz-rs-wrap dnz-rs-compact" : "dnz-rs-wrap dnz-rs-has-label") @attributes="AdditionalAttributes">
		<RadzenFormField Text=@Label Variant="Variant.Flat" class=@(_rootClass) Style=@($"width:{Width};" + Style)>
			<Start>
				@if (Icon.IsNotEmpty()) {
					<RadzenIcon Icon=@Icon />
				}
			</Start>
			<ChildContent>

				@if (isInitializing && DefaultID.IsNotEmpty()) {
					<div class=@_contentClass>
						<DnzSkeleton Lines="1" MaxWidth="80%" />
					</div>
				} else {

					@* Dos anclas fijas dentro del envoltorio, igual que row-selector-open/-remove/-add:
					   -content es lo que se pulsa para abrir el desplegable, -text es el valor elegido.
					   Fijas y no derivadas porque el envoltorio ya lleva el data-testid del consumidor
					   (viaja en AdditionalAttributes), asi que el test acota por el y dentro busca estas. *@
					<div @ref=containerRef tabindex=@(Disabled ? null : "0") role="combobox" aria-haspopup="listbox" aria-expanded=@(_popupOpen ? "true" : "false") aria-required=@(IsRequired ? "true" : null) aria-label=@_ariaLabel @onclick=@(args => ToggleAsync()) @onkeydown=@OnKeyDown class=@_contentClass data-testid="row-selector-content">
						<span class="dnz-rs-text" data-testid="row-selector-text" title=@(SelectedRow.IsNotEmpty() ? SelectedRow.Label : null)>
							@if (SelectedRow.IsNotEmpty()) {
								@SelectedRow.Label
							} else if (Placeholder.IsNotEmpty()) {
								<span class="dnz-rs-placeholder">@Placeholder</span>
							} else if (_isCompact && Disabled == false) {
								<span class="dnz-rs-placeholder">Seleccionar...</span>
							}
						</span>
					</div>

				}

			</ChildContent>
			<End>
				<div class="dnz-rs-end">
					<RadzenIcon Icon="arrow_drop_down" Style=@($"font-size:20px;{(Disabled ? "opacity:0.4;" : "cursor:pointer;")}") class=@(Disabled ? "" : "dnz-icon-hover") @onclick=@(args => ToggleAsync()) />
				</div>
			</End>
		</RadzenFormField>
		<div class="dnz-rs-actions-overlay">
			@if (SelectedRow.IsNotEmpty()) {
				@if (SelectedRow.SectionID.IsNotEmpty() && (OnOpenRecord.HasDelegate || OpenInWindow)) {
					<RadzenIcon Icon="open_in_new" Style="font-size:16px;cursor:pointer" class="dnz-icon-hover" role="button" aria-label="Abrir ficha" onclick=@(() => OnOpenClick()) data-testid="row-selector-open" />
				}
				@if (Disabled == false) {
					<RadzenIcon Icon="close" Style="font-size:16px;cursor:pointer;color:var(--rz-danger)" class="dnz-icon-hover" role="button" aria-label="Quitar selección" onclick=@(() => OnClearClick()) data-testid="row-selector-remove" />
				}
			} else if (Disabled == false && OnAdd.HasDelegate) {
				<RadzenIcon Icon="add" Style="font-size:16px;cursor:pointer;color:var(--rz-success)" class="dnz-icon-hover" role="button" aria-label="Crear nuevo" onclick=@(() => OnAddClick()) data-testid="row-selector-add" />
			}
		</div>
	</div>
</ErrorBoundary>

<RadzenPopup @ref=popup Lazy=true Open="@OnPopupOpen" Close="@OnPopupClose" Style="display:none;position:absolute;padding:5px;width:min(600px,92vw);max-height:70vh;overflow:auto;" class="dnz-rs-popup" data-testid="row-selector-popup">
	<ErrorBoundary>
		<div class="dnz-rs-popup-head">
			<DnzSearchInput BounceValueChanged=@OnDebouncedSearch Class="flex-grow-1" />
			@if (Disabled == false && OnAdd.HasDelegate) {
				<RadzenButton Icon="add" Text="Crear nuevo" Size="ButtonSize.Small" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success" Click=@OnAddFromPopupClick data-testid="row-selector-popup-add" />
			}
		</div>
		<DnzReportView ShowAdd=false ShowSearch=false ShowTitle=false Client=@Client AdminMode=@AdminMode AdvancedFilter=@AdvancedFilter FetchInterceptor=@FetchInterceptor @ref=reportControl OnItemSelect=@(async (x) => { await SelectAsync(x); }) ReportId=@ReportId Limit="20" />
	</ErrorBoundary>
</RadzenPopup>


@code {

	bool _isCompact => Label.IsEmpty();
	bool _popupOpen;

	[Parameter] public string Icon { get; set; }
	[Parameter] public bool AdminMode { get; set; } = false;
	[Parameter, EditorRequired] public DinaupClientC Client { get; set; }

	public async Task ToggleAsync() {
		if (isInitializing || Disabled) return;
		await popup.ToggleAsync(containerRef);
	}

	[Parameter] public string Class { get; set; } = "";

	private async Task OnDebouncedSearch(string value) {
		if (Disabled) return;
		await reportControl.UpdateSearchAsync(value ?? string.Empty);
	}

	DnzReportView reportControl;
	ElementReference containerRef;
	RadzenPopup popup;

	[Parameter] public string Width { get; set; } = "280px";
	[Parameter] public string Style { get; set; } = "flex:1";
	[Parameter] public string Placeholder { get; set; }
	[Parameter] public EventCallback<IDinaupRow> SelectedRowChanged { get; set; }
	[Parameter] public IDinaupRow SelectedRow { get; set; }
	[Parameter] public string Label { get; set; }
	[Parameter] public string ReportId { get; set; }
	[Parameter] public bool IsRequired { get; set; }
	[Parameter] public bool Disabled { get; set; }
	[Parameter] public List<FilterCondition> AdvancedFilter { get; set; }
	[Parameter] public EventCallback<Guid> OnAdd { get; set; }
	[Parameter] public EventCallback<IDinaupRow> OnOpenRecord { get; set; }
	[Parameter] public bool OpenInWindow { get; set; } = true;
	[Parameter] public Guid DefaultID { get; set; }
	// Etiqueta ya conocida por el caller: pinta la seleccion inicial sin viaje al servidor y sin notificar SelectedRowChanged.
	[Parameter] public string DefaultLabel { get; set; }
	// Passthrough del hook de cache de DnzReportView: reabrir el popup sin cambios sirve la primera ventana desde cache.
	[Parameter] public Func<string, bool, Func<Task<Dinaup.ReportResponse>>, Task<Dinaup.ReportResponse>> FetchInterceptor { get; set; }
	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

	string _rootClass => "dropdown-menu-component"
		+ ((IsRequired && SelectedRow.IsEmpty()) ? " obli" : "")
		+ (Disabled ? " dropdown-menu-component-disabled" : "")
		+ " " + Class;

	string _contentClass => "dnz-rs-content"
		+ (_isCompact ? "" : " dnz-rs-with-label")
		+ (Disabled ? " dnz-rs-disabled" : "");

	string _ariaLabel => Label.IsNotEmpty() ? Label : (Placeholder.IsNotEmpty() ? Placeholder : "Seleccionar registro");

	bool isInitializing = true;
	Guid _lastProcessedDefaultID = Guid.Empty;

	protected override async Task OnInitializedAsync() {
		await base.OnInitializedAsync();
		if (DefaultID.IsNotEmpty()) {
			_lastProcessedDefaultID = DefaultID;
			if (DefaultLabel.IsNotEmpty()) SelectedRow = new Dinaup.DinaupBasicInformation(DefaultID, DefaultLabel);
			else await SelectByIdAsync(DefaultID);
		}
		isInitializing = false;
	}

	protected override async Task OnParametersSetAsync() {
		await base.OnParametersSetAsync();
		if (DefaultID != _lastProcessedDefaultID && DefaultID.IsNotEmpty() && SelectedRow.IsEmpty()) {
			_lastProcessedDefaultID = DefaultID;
			if (DefaultLabel.IsNotEmpty()) SelectedRow = new Dinaup.DinaupBasicInformation(DefaultID, DefaultLabel);
			else await SelectByIdAsync(DefaultID);
		}
	}

	public async Task SelectAsync(Dinaup.DinaupBasicInformation data) => await SelectAsync(data.ToDinaupDynamicRowDTO());
	public async Task SelectAsync(DnzRowSelector source) => await SelectAsync(source.SelectedRow);

	public async Task SelectByIdAsync(Guid ID) {
		if (ID.IsNotEmpty()) {
			var paramsX = new ReportRequestParameters(ReportId, 1);
			paramsX.AddFilter("id", "=", ID);
			// AdminMode fijo a proposito: la precarga resuelve la etiqueta de un valor YA guardado aunque el informe filtre por permisos.
			paramsX.AdminMode = true;
			paramsX.GetPageSummary = false;
			var result = await Client.Report_GetAsync(paramsX);
			var rows = result.DataList.GetDynamicsRowsOBJ();
			if (rows.IsNotEmpty()) await SelectAsync(rows.FirstOrDefault());
		}
	}

	public async Task SelectAsync(IDinaupRow dataRow) {
		if (dataRow.IsNull()) SelectedRow = null;
		else SelectedRow = dataRow;
		await SelectedRowChanged.InvokeAsync(SelectedRow);
		await InvokeAsync(this.StateHasChanged);
		if (popup.IsNotNull() && popup.IsOpen) {
			try { await popup.CloseAsync(); } catch { }
		}
	}

	async Task OnPopupOpen() {
		if (Disabled) return;
		_popupOpen = true;
	}

	// El render del propio evento desmonta el contenido Lazy tambien al cerrar con clic fuera: libera el informe y la proxima apertura arranca limpia.
	async Task OnPopupClose() {
		_popupOpen = false;
	}

	private async Task OnKeyDown(KeyboardEventArgs e) {
		if (Disabled) return;
		if (e.Key == "Enter" || e.Key == "ArrowDown") await ToggleAsync();
		else if ((e.Key == "Delete" || e.Key == "Backspace") && SelectedRow.IsNotEmpty()) await SelectAsync((IDinaupRow)null);
	}

	private async Task OnAddClick() {
		if (Disabled) return;
		if (OnAdd.HasDelegate) await OnAdd.InvokeAsync();
	}

	private async Task OnAddFromPopupClick() {
		if (popup.IsNotNull() && popup.IsOpen) {
			try { await popup.CloseAsync(); } catch { }
		}
		await OnAddClick();
	}

	private async Task OnClearClick() => await SelectAsync((IDinaupRow)null);

	private async Task OnOpenClick() {
		if (this.SelectedRow.IsNull()) return;
		if (OnOpenRecord.HasDelegate) await OnOpenRecord.InvokeAsync(this.SelectedRow);
		else if (OpenInWindow) DnzFormView.OpenAsWindow(_windowManager, Client, SelectedRow.SectionID.STR(), SelectedRow.Id.STR());
	}
}
