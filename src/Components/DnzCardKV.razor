<DnzCard Style=@Style class="d-flex gap-2 align-items-center p-2" Variant=@Variant @attributes="AdditionalAttributes">

	<div class="d-flex align-items-center justify-content-center" style="min-height: 56px; min-width: 56px">
		<RadzenIcon Style="font-size: 32px" Icon=@Icon IconColor=@IconColor />
	</div>
	<div class="flex-grow-1 d-flex flex-column align-items-start">
		<span class="rz-text-overline">@(Title.IsNotEmpty() ? Title : Tile)</span>
		<span class="rz-text-h5">@Value</span>
	</div>

</DnzCard>

@code {

	// Nullable a proposito: null = "que lo decida la profundidad". Aqui el default
	// anterior era Flat clavado, asi que suelta (nivel 0) ahora sale Filled como el
	// resto de la familia; anidada dentro de otro DnzCard sigue saliendo Flat.
	[Parameter]
	public Variant? Variant { get; set; }


	/// <summary>
	/// Nombre del icono a mostrar (ej: "home", "person", etc.)
	/// </summary>
	[Parameter]
	public string Icon { get; set; } = string.Empty;

	/// <summary>
	/// Color del icono
	/// </summary>
	[Parameter]
	public string IconColor { get; set; } = Colors.Primary;

	/// <summary>
	/// Título o etiqueta del card. (Preferido: usar Title. Se mantiene por compatibilidad con consumidores existentes.)
	/// </summary>
	[Parameter]
	public string Tile { get; set; } = string.Empty;

	/// <summary>
	/// Título o etiqueta del card.
	/// </summary>
	[Parameter]
	public string Title { get; set; } = string.Empty;

	/// <summary>
	/// Valor principal a mostrar
	/// </summary>
	[Parameter]
	public string Value { get; set; } = string.Empty;


	/// <summary>
	/// Estilo CSS inline aplicado al card
	/// </summary>
	[Parameter]
	public string Style { get; set; } = string.Empty;

	[Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object> AdditionalAttributes { get; set; }

}