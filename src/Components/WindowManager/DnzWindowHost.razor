@namespace DinaZen.Components.WindowManager
@implements IAsyncDisposable
@inject DnzWindowManagerService WM
@inject IJSRuntime JS
@inject Radzen.NotificationService NotificationService

@* Las ventanas van SUELTAS, sin div que las envuelva. Dos razones, las dos duras:
   1) Cualquier envoltorio con `position: fixed` crea contexto de apilado el solo —aunque no lleve
      z-index— y encierra dentro a sus ventanas: ninguna podria ponerse por delante de un modal
      Radzen (1250) por mucho z-index que se le pusiera. Sueltas, cada una compite de tu a tu.
   2) Repartirlas en dos divs (uno por banda) obliga a MOVERLAS de div al cambiar de altura, y
      moverlas las destruye y las vuelve a crear (Blazor no reutiliza el componente entre listas
      distintas): se perderia lo tecleado dentro. Cambiar de altura tiene que ser cambiar un
      numero, nunca cambiar de sitio.
   El z-index de cada ventana lo calcula DnzWindowManagerService por orden de apertura. *@
@foreach (var win in WM.Windows)
{
	<DnzWindow @key="win.Id" State="win" OnCloseRequest="HandleClose" OnMinimizeRequest="HandleMinimize" OnMaximizeRequest="HandleMaximize" OnFocusRequest="HandleFocus" />
}
@if (WM.Windows.Any())
{
	<DnzTaskbar />
}

@code {
	private IJSObjectReference _jsModule;
	private DotNetObjectReference<DnzWindowHost> _dotNetRef;
	private bool _viewportInitialized;

	protected override void OnInitialized()
	{
		WM.OnChanged += HandleStateChanged;
		WM.OnMaxWindowsReached += HandleMaxWindowsReached;
		WM.OnVentanaOcupada += HandleVentanaOcupada;
	}

	// Se pidio una ventana de las que solo puede haber una y la tiene otra sesion. Info y no Warning:
	// no ha fallado nada, es que ya esta abierta en otro sitio. El texto lo trae la app, que es la
	// unica que sabe si es "en otra pestana tuya" o "la tiene Ana Ruiz".
	private void HandleVentanaOcupada(string aviso)
	{
		InvokeAsync(() =>
		{
			NotificationService.Notify(new Radzen.NotificationMessage
			{
				Severity = Radzen.NotificationSeverity.Info,
				Summary = "Ya está abierta",
				Detail = aviso,
				Duration = 5000
			});
		});
	}

	private void HandleMaxWindowsReached()
	{
		InvokeAsync(() =>
		{
			NotificationService.Notify(new Radzen.NotificationMessage
			{
				Severity = Radzen.NotificationSeverity.Warning,
				Summary = "Límite de ventanas",
				Detail = $"No se pueden abrir más de {DnzWindowManagerService.MaxWindows} ventanas. Cierra alguna para continuar.",
				Duration = 4000
			});
		});
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (_viewportInitialized == false)
		{
			try
			{
				_jsModule = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/DinaZen/dinazen-windows.js");
				var vp = await _jsModule.InvokeAsync<ViewportInfo>("getViewport");
				WM.SetViewport(vp.Width, vp.Height);

				_dotNetRef = DotNetObjectReference.Create(this);
				await _jsModule.InvokeVoidAsync("initEscapeClose", _dotNetRef);

				// Si habia ventanas abiertas antes del viewport, actualizar su posicion en el DOM
				var repositioned = WM.FlushRepositioned();
				if (repositioned != null)
				{
					foreach (var win in repositioned)
						await _jsModule.InvokeVoidAsync("setPosition", $"dnz-win-{win.Id}", win.X, win.Y, win.Width, win.Height);
				}

				_viewportInitialized = true;
			}
			catch { }
		}

		// En cada render: los modales de Radzen reciben el z-index que les toca en la fila. Tiene
		// que ser aqui y no en el servicio porque el z-index de un dialogo solo se puede tocar
		// sobre su DOM ya renderizado.
		if (_jsModule != null)
		{
			try { await _jsModule.InvokeVoidAsync("applyDialogZIndex", WM.ModalZIndexes); }
			catch { }
		}
	}

	[JSInvokable]
	public void JsEscapePressed()
	{
		WM.CloseActive();
	}

	[JSInvokable]
	public void JsViewportChanged(double width, double height)
	{
		WM.SetViewport(width, height);
	}

	private void HandleClose(string id) => WM.Close(id);
	private void HandleMinimize(string id) => WM.Minimize(id);
	private void HandleMaximize(string id) => WM.ToggleMaximize(id);
	private void HandleFocus(string id) => WM.Focus(id);

	private void HandleStateChanged()
	{
		InvokeAsync(StateHasChanged);
	}

	public async ValueTask DisposeAsync()
	{
		WM.OnChanged -= HandleStateChanged;
		WM.OnMaxWindowsReached -= HandleMaxWindowsReached;
		WM.OnVentanaOcupada -= HandleVentanaOcupada;
		if (_jsModule != null)
		{
			try
			{
				await _jsModule.InvokeVoidAsync("disposeEscapeClose");
				await _jsModule.DisposeAsync();
			}
			catch { }
		}
		_dotNetRef?.Dispose();
	}

	private record ViewportInfo(double Width, double Height);
}
