@*
	Historial de cambios de UN campo (auditoría).
	Escenarios de diseño:
	E1: el header muestra el campo que se está mirando (label humano si el caller lo pasa) y el nº de cambios.
	E2: el valor vigente se destaca arriba ("Valor actual") con autor y fecha del último cambio.
	E3: cada cambio se lee en <1s — inline "antes → después" si los valores son cortos,
	    bloques apilados −/+ si son largos. Sin toggle manual: el layout se adapta solo.
	E4: colores semánticos del tema (variables CSS): rojo=valor anterior, verde=valor nuevo. Dark mode OK.
	E5: skeleton de timeline mientras carga; estado vacío que menciona el campo.
	E6: timeline agrupada por fecha (Hoy/Ayer/Esta semana/...), avatar + autor + hora en cada entrada.
*@
@using DinaZen.Components
<DnzDialogLayout>
	<TitleContent>
		<div class="d-flex align-items-center justify-content-between w-100">
			<div class="d-flex align-items-center gap-2" style="min-width:0">
				<RadzenIcon Icon="history" Style="color:var(--rz-primary); font-size:20px" />
				<span class="fw-semibold text-nowrap">Historial</span>
				@if (EtiquetaCampo.IsNotEmpty())
				{
					<span class="dnz-history-field-chip" title="@Field">@EtiquetaCampo</span>
				}
				@if (cargando == false && entradas.IsNotEmpty())
				{
					<RadzenBadge BadgeStyle="BadgeStyle.Light" Text="@(entradas.Count == 1 ? "1 cambio" : $"{entradas.Count} cambios")" Style="font-size:11px" />
				}
			</div>
			<RadzenButton Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
						  Click="@(() => DialogService.Close())" Style="opacity:0.6" />
		</div>
	</TitleContent>
	<BodyContent>

		@if (cargando)
		{
			<div class="dnz-history-skeleton">
				@for (int i = 0; i < 5; i++)
				{
					<div class="dnz-history-skeleton-item">
						<div class="dnz-history-skeleton-dot"></div>
						<div class="dnz-history-skeleton-content">
							<DnzSkeleton Lines="1" Height="0.7rem" MaxWidth="55%" />
							<DnzSkeleton Lines="2" Height="0.9rem" MaxWidth="100%" />
						</div>
					</div>
				}
			</div>
		}
		else if (entradas.IsNotEmpty())
		{
			@* E2: héroe — valor vigente del campo *@
			<div class="dnz-history-current">
				<div class="dnz-history-current-label">
					<RadzenIcon Icon="check_circle" Style="font-size:14px" />
					<span>Valor actual</span>
				</div>
				@if (valorActual.IsNotEmpty())
				{
					<div class="dnz-history-current-value">@valorActual</div>
				}
				else
				{
					<div class="dnz-history-current-value dnz-history-current-value--empty">(vacío)</div>
				}
				<div class="dnz-history-current-meta">
					<DnzAvatarInitial Data="@entradas[0].EditedByUserName" Size="1.2rem" Style="font-size:0.6rem" />
					<span>@entradas[0].EditedByUserName</span>
					<DnzSpanDateTime Value="@entradas[0].EditedOn" Caption="true" FontSize="11px" />
				</div>
			</div>

			<div class="dnz-history-timeline">
				@{ string lastGroup = null; }
				@foreach (var item in entradas)
				{
					var group = GetDateGroupLabel(item.EditedOn);
					@if (group != lastGroup)
					{
						lastGroup = group;
						<div class="dnz-history-date-group">
							<span class="dnz-history-date-label">@group</span>
							<div class="dnz-history-date-line"></div>
						</div>
					}

					var oldVal = item.OldValueText.IfIsEmpty(item.OldValue);
					var newVal = item.NewValueText.IfIsEmpty(item.NewValue);

					<div class="dnz-history-entry">
						<div class="dnz-history-rail">
							<div class="dnz-history-dot"></div>
							<div class="dnz-history-connector"></div>
						</div>

						<div class="dnz-history-content">
							<div class="dnz-history-meta">
								<DnzAvatarInitial Data="@item.EditedByUserName" Size="1.4rem" Style="font-size:0.65rem" />
								<span class="dnz-history-author">@item.EditedByUserName</span>
								<DnzSpanDateTime Value="@item.EditedOn" Caption="true" FontSize="11px" />
							</div>

							@* E3: layout adaptativo — inline si corto, bloques si largo *@
							@if (EsCorto(oldVal, newVal))
							{
								<div class="dnz-history-inline">
									@if (oldVal.IsNotEmpty())
									{
										<span class="dnz-history-inline-old">@oldVal</span>
									}
									else
									{
										<span class="dnz-history-inline-empty">vacío</span>
									}
									<RadzenIcon Icon="arrow_forward" Style="font-size:12px" />
									@if (newVal.IsNotEmpty())
									{
										<span class="dnz-history-inline-new">@newVal</span>
									}
									else
									{
										<span class="dnz-history-inline-empty">vacío</span>
									}
								</div>
							}
							else
							{
								<div class="dnz-history-diff">
									@if (oldVal.IsNotEmpty())
									{
										<div class="dnz-history-diff-removed">
											<RadzenIcon Icon="remove" Style="font-size:12px" />
											<span>@oldVal</span>
										</div>
									}
									else
									{
										<div class="dnz-history-diff-empty">
											<span class="rz-text-caption">(vacío)</span>
										</div>
									}
									<div class="dnz-history-diff-added">
										<RadzenIcon Icon="add" Style="font-size:12px" />
										<span>@newVal</span>
									</div>
								</div>
							}
						</div>
					</div>
				}
			</div>
		}
		else
		{
			<div class="dnz-history-empty">
				<RadzenIcon Icon="history_toggle_off" Style="font-size:48px; opacity:0.2" />
				@if (EtiquetaCampo.IsNotEmpty())
				{
					<span class="dnz-history-empty-text">El campo "@EtiquetaCampo" no tiene cambios registrados.</span>
				}
				else
				{
					<span class="dnz-history-empty-text">No se han registrado cambios.</span>
				}
			</div>
		}

	</BodyContent>
</DnzDialogLayout>


@code {

	public static async Task Open(DialogService dialogService, DinaupClientC client, Guid sectionId, Guid rowId, string field, string fieldLabel = null)
	{
		var parameters = new Dictionary<string, object>()
		{
			{ nameof(Client), client },
			{ nameof(SectionId), sectionId },
			{ nameof(Id), rowId },
			{ nameof(Field), field },
			{ nameof(FieldLabel), fieldLabel }
		};
		var options = new DialogOptions()
		{
			Width = "min(95%, 700px)",
			Height = "70%",
			ShowClose = false,
			ShowTitle = false,
			Resizable = true,
			Draggable = true,
			CloseDialogOnOverlayClick = true,
			CloseDialogOnEsc = true
		};

		await dialogService.OpenAsync<DnzHistoricoDialog>("Historial", parameters, options);
	}


	[Parameter] public DinaupClientC Client { get; set; }
	[Parameter] public Guid Id { get; set; }
	[Parameter] public Guid SectionId { get; set; }
	[Parameter] public string Field { get; set; }

	/// <summary>Nombre humano del campo (label del formulario). Si falta, se muestra el nombre nativo.</summary>
	[Parameter] public string FieldLabel { get; set; }

	private List<DinaupFieldChangeDTO> entradas = new();
	private string valorActual = "";
	private bool cargando = true;

	private string EtiquetaCampo => FieldLabel.IfIsEmpty(Field);

	protected async override Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		var lista = await Client.GetHistoryChanges(SectionId, Id, Field);
		entradas = lista.OrderByDescending(x => x.EditedOn).ToList();
		if (entradas.IsNotEmpty())
			valorActual = entradas[0].NewValueText.IfIsEmpty(entradas[0].NewValue);
		cargando = false;
		StateHasChanged();
	}

	// Inline solo si ambos valores caben en una línea legible (E3)
	private static bool EsCorto(string oldVal, string newVal)
	{
		var total = (oldVal ?? "").Length + (newVal ?? "").Length;
		if (total > 60) return false;
		if ((oldVal ?? "").Contains('\n')) return false;
		if ((newVal ?? "").Contains('\n')) return false;
		return true;
	}

	private string GetDateGroupLabel(DateTime date)
	{
		var today = DateTime.Today;
		if (date.Date == today) return "Hoy";
		if (date.Date == today.AddDays(-1)) return "Ayer";
		if (date.Date >= today.AddDays(-7)) return "Esta semana";
		if (date.Date.Month == today.Month && date.Date.Year == today.Year) return "Este mes";
		return date.ToString("MMMM yyyy");
	}
}
