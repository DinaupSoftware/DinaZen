@inject IJSRuntime JS
<style>
	.rz-dialog-content {
		position: absolute;
		inset: 0;
		overflow: hidden;
		padding: 0;
	}

	.grid-layout {
		display: grid;
		grid-template-rows: auto 1fr auto;
		height: 100%;
	}

	.scrollable-content {
		overflow-y: auto;
	}

	.dialog-estandar-layout--styled {
		background: var(--dnz-tab-content-bg, #f0f1f3);
	}
</style>

<div @ref=rootElement class="dialog-estandar-layout h-100 grid-layout @(Flat ? "" : "dialog-estandar-layout--styled")">
	<div class="dialog-estandar-layout-header" style=@HeaderStyle>
		@if (TitleContent != null)
		{
			@TitleContent
		}
		else
		{
			<div class="d-flex align-items-center justify-content-between w-100">
				<div class="d-flex align-items-center gap-2">
					@if (Icon.IsNotEmpty())
					{
						<RadzenIcon Icon="@Icon" Style="color:var(--rz-primary); font-size:20px" />
					}
					<span class="fw-semibold">@Title</span>
				</div>
				<RadzenButton data-testid="dialog-close-header" Icon="close" ButtonStyle="ButtonStyle.Light" Variant="Variant.Text" Size="ButtonSize.Small"
							  Click="@Cerrar" Style="opacity:0.6" />
			</div>
		}
	</div>

	<div class="dialog-estandar-layout-content scrollable-content" style=@ContentStyle>
		@if (ErrorText.IsNotEmpty())
		{
			<div class="p-3">
				<RadzenAlert AlertStyle="AlertStyle.Danger" Shade="Shade.Light" AllowClose=false ShowIcon=true>
					<div class="d-flex align-items-center justify-content-between w-100 gap-2">
						<span>@ErrorText</span>
						@if (OnRetry.HasDelegate)
						{
							<RadzenButton Text="Reintentar" Icon="refresh" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click=@Reintentar />
						}
					</div>
				</RadzenAlert>
			</div>
		}
		else if (IsLoading && LoadingText.IsNotEmpty())
		{
			<div class="d-flex flex-column align-items-center gap-3 py-5">
				<DnzLoader />
				<span class="rz-text-caption">@LoadingText</span>
			</div>
		}
		else if (IsLoading)
		{
			<div class="p-3"><DnzSkeleton /></div>
		}
		else
		{
			@BodyContent
		}
	</div>

	<div class="dialog-estandar-layout-footer">
		@if (FooterContent != null)
		{
			@FooterContent
		}
		else
		{
			<div class="d-flex justify-content-end gap-1 align-items-center me-4">
				<RadzenButton data-testid="dialog-close-footer" Click=@Cerrar ButtonStyle="ButtonStyle.Danger" Text="Cerrar" Icon="close" Variant="Variant.Text" />
			</div>
		}
	</div>
</div>

@code {

	private ElementReference rootElement;
	private bool isClosed = false;

	/// <summary>
	/// Titulo del dialog (se usa si no se proporciona TitleContent).
	/// </summary>
	[Parameter] public string Title { get; set; }

	/// <summary>
	/// Icono Material Design del header (se usa si no se proporciona TitleContent).
	/// </summary>
	[Parameter] public string Icon { get; set; }

	/// <summary>
	/// Header custom. Si se omite, se genera automaticamente con Title + Icon + boton close.
	/// </summary>
	[Parameter] public RenderFragment TitleContent { get; set; }

	[Parameter] public RenderFragment BodyContent { get; set; }

	/// <summary>
	/// Footer custom. Si se omite, se muestra boton "Cerrar" por defecto.
	/// </summary>
	[Parameter] public RenderFragment FooterContent { get; set; }

	[Parameter] public string ContentStyle { get; set; }
	[Parameter] public string HeaderStyle { get; set; }

	/// <summary>
	/// Mientras es true el cuerpo muestra un esqueleto de carga en lugar de BodyContent.
	/// </summary>
	[Parameter] public bool IsLoading { get; set; }

	/// <summary>
	/// Mensaje de progreso durante la carga. Si se proporciona, en vez del esqueleto se muestra
	/// un loader con este texto debajo: para esperas largas donde conviene contar qué se está haciendo.
	/// </summary>
	[Parameter] public string LoadingText { get; set; }

	/// <summary>
	/// Si tiene texto, el cuerpo se sustituye por un aviso de error. Manda sobre IsLoading:
	/// si algo ha fallado no se sigue mostrando un esqueleto de carga.
	/// </summary>
	[Parameter] public string ErrorText { get; set; }

	/// <summary>
	/// Accion de reintento del error. Solo si se proporciona aparece el boton "Reintentar":
	/// un error de configuracion (no se arregla reintentando) se deja sin handler.
	/// </summary>
	[Parameter] public EventCallback OnRetry { get; set; }

	/// <summary>
	/// Si true, el dialog es completamente blanco/plano (sin degradados ni fondo gris).
	/// Por defecto false: header y footer con degradado sutil, contenido con fondo gris.
	/// </summary>
	[Parameter] public bool Flat { get; set; } = false;

	public void Cerrar()
	{
		if (isClosed == false)
		{
			isClosed = true;
			DialogService.Close();
		}
	}

	private async Task Reintentar()
	{
		await OnRetry.InvokeAsync();
	}

	public async Task SetWidth(string width)
	{
		await JS.InvokeVoidAsync("DinaZen.setDialogWidth", rootElement, width);
	}

	public async Task SetHeight(string height)
	{
		await JS.InvokeVoidAsync("DinaZen.setDialogHeight", rootElement, height);
	}
}
